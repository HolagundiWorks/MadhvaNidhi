<?xml version="1.0" encoding="utf-8"?>
<!-- Madhva Dvija host: one page at a time, with the floating dock (same shape as Madhva Nidhi's). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Pages stop above the dock, so the last items stay reachable. -->
    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dvija_dock_clearance" />

    <LinearLayout
        android:id="@+id/dvijaDock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_dock_total_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/ds_space_4"
        android:layout_marginEnd="@dimen/ds_space_4"
        android:layout_marginBottom="@dimen/ds_space_4"
        android:background="@drawable/bg_floating_nav"
        android:elevation="@dimen/ds_nav_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_dock_padding"
        android:paddingEnd="@dimen/ds_dock_padding">

        <ImageButton
            android:id="@+id/dockSandhya"
            style="@style/Widget.MadhvaNidhi.IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/ds_space_2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_sun" />

        <ImageButton
            android:id="@+id/dockJapa"
            style="@style/Widget.MadhvaNidhi.IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/ds_space_2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_japa_eda" />

        <ImageButton
            android:id="@+id/dockPuja"
            style="@style/Widget.MadhvaNidhi.IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/ds_space_2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_puja" />

        <!-- Space for the raised Home button in the middle. -->
        <View
            android:layout_width="@dimen/ds_dock_center_size"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/dockProfile"
            style="@style/Widget.MadhvaNidhi.IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/ds_space_2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_user" />

        <ImageButton
            android:id="@+id/dockSettings"
            style="@style/Widget.MadhvaNidhi.IconButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/ds_space_2"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_settings" />
    </LinearLayout>

    <!-- Raised circular Home button, half over the bar's top edge. -->
    <FrameLayout
        android:id="@+id/dockHome"
        android:layout_width="@dimen/ds_dock_center_size"
        android:layout_height="@dimen/ds_dock_center_size"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/ds_dock_center_offset"
        android:background="@drawable/ds_dock_center_fill"
        android:clickable="true"
        android:focusable="true"
        android:elevation="@dimen/ds_dock_center_elevation"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/dockHomeIcon"
            android:layout_width="@dimen/ds_size_icon"
            android:layout_height="@dimen/ds_size_icon"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_home" />
    </FrameLayout>
</FrameLayout>
