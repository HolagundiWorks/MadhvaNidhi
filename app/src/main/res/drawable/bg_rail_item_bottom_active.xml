<?xml version="1.0" encoding="utf-8"?>
<!-- Floating navigation: the active destination is a true circle (40dp, radius = half). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center"
        android:width="@dimen/ds_nav_item_size"
        android:height="@dimen/ds_nav_item_size">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_primary" />
            <corners android:radius="@dimen/ds_nav_item_radius" />
        </shape>
    </item>
</layer-list>
