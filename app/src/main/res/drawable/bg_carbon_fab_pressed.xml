<?xml version="1.0" encoding="utf-8"?>
<!-- Selected nitya-fab: layer-selected + interactive bottom inset -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/carbon_layer_selected" />
            <stroke
                android:width="@dimen/carbon_border_width"
                android:color="@color/carbon_border_interactive" />
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/carbon_border_interactive" />
        </shape>
    </item>
</layer-list>
