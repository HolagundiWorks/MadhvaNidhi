<?xml version="1.0" encoding="utf-8"?>
<!-- Madhva Nidhi home: today's Panchanga, then the public library. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_4">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_2"
            android:text="@string/home_today"
            android:textAppearance="@style/TextAppearance.DS.Subtitle" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_4"
            style="@style/Widget.MadhvaNidhi.SurfaceCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_4">

                <TextView
                    android:id="@+id/homeObservance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.DS.Body"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/homeTithi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:textAppearance="@style/TextAppearance.DS.Subtitle" />

                <TextView
                    android:id="@+id/homePaksha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.DS.Body" />

                <TextView
                    android:id="@+id/homeNakshatra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_2"
                    android:textAppearance="@style/TextAppearance.DS.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_2"
            android:text="@string/home_explore"
            android:textAppearance="@style/TextAppearance.DS.Subtitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeStotra"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_2"
            android:minHeight="@dimen/ds_touch_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeGrantha"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_2"
            android:minHeight="@dimen/ds_touch_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeSampada"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_2"
            android:minHeight="@dimen/ds_touch_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeSangeeta"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_2"
            android:minHeight="@dimen/ds_touch_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homeSamskruti"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_2"
            android:minHeight="@dimen/ds_touch_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/homePuja"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_dock_clearance"
            android:minHeight="@dimen/ds_touch_min" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
