<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/carbon_layer"
        android:orientation="vertical"
        android:padding="@dimen/carbon_spacing_04">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Carbon.TextInput.ExposedDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ನಿತ್ಯ ಪಾರಾಯಣ"
            app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius"
            app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
            app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
            app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/nityaSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="2" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/carbon_border_width"
        android:background="@color/carbon_border_subtle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_05">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_label"
                android:textAppearance="@style/TextAppearance.Carbon.Label01"
                android:textColor="@color/carbon_text_secondary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/nityaReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_spacing_03"
                android:lineSpacingMultiplier="1.5"
                android:textAppearance="@style/TextAppearance.Carbon.Body02"
                android:textColor="@color/carbon_text_primary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/carbon_border_width"
        android:background="@color/carbon_border_subtle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/carbon_layer"
        android:paddingHorizontal="@dimen/carbon_spacing_05"
        android:paddingVertical="@dimen/carbon_spacing_03">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nityaOpenContent"
            style="@style/Widget.Carbon.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/carbon_layout_size_height_lg"
            android:text="@string/open_content"
            app:cornerRadius="@dimen/carbon_corner_radius"
            app:icon="@drawable/ic_launch"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/carbon_spacing_03" />
    </LinearLayout>
</LinearLayout>
