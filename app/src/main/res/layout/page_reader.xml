<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:id="@+id/readerScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/readerMain" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/carbon_spacing_05" app:layout_constraintWidth_max="880dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/readerHeader">
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/readerTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Heading03" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/readerKalaField" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/kalaMorning" style="@style/Widget.Carbon.Button.GhostOutlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="ಪ್ರಾತಃ" android:contentDescription="ಪ್ರಾತಃ ಸಂಧ್ಯಾವಂದನೆ" app:icon="@drawable/ic_morning" app:cornerRadius="@dimen/carbon_corner_radius" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/kalaNoon" style="@style/Widget.Carbon.Button.GhostOutlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="ಮಧ್ಯಾಹ್ನ" android:contentDescription="ಮಾಧ್ಯಾಹ್ನಿಕ ಸಂಧ್ಯಾವಂದನೆ" app:icon="@drawable/ic_noon" app:cornerRadius="@dimen/carbon_corner_radius" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/kalaEvening" style="@style/Widget.Carbon.Button.GhostOutlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="ಸಾಯಂ" android:contentDescription="ಸಾಯಂ ಸಂಧ್ಯಾವಂದನೆ" app:icon="@drawable/ic_evening" app:cornerRadius="@dimen/carbon_corner_radius" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/readerItemField" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ಓದುವ ಪಠ್ಯ" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius" app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius" app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/readerItem" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:maxLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/readerSelect" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="ಆಯ್ಕೆಮಾಡಿ" style="@style/Widget.Carbon.Button.GhostOutlined" app:cornerRadius="@dimen/carbon_corner_radius" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/readerSelectBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="ಆಯ್ಕೆಮಾಡಿ" android:visibility="gone" app:cornerRadius="@dimen/carbon_corner_radius" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/readerSelectLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body02" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/readerSubpages" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.button.MaterialButton android:id="@+id/subpageMantras" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="" style="@style/Widget.Carbon.Button.GhostOutlined" android:layout_weight="1" app:cornerRadius="@dimen/carbon_corner_radius" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/subpageStotras" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="" style="@style/Widget.Carbon.Button.GhostOutlined" android:layout_weight="1" app:cornerRadius="@dimen/carbon_corner_radius" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/subpageSuktas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="" style="@style/Widget.Carbon.Button.GhostOutlined" android:layout_weight="1" app:cornerRadius="@dimen/carbon_corner_radius" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/readerCrumb" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body01" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" />
                </LinearLayout>
                <com.google.android.material.textview.MaterialTextView android:id="@+id/readerHead" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Heading03" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/readerBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body02" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/selectorPage" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/carbon_spacing_05" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/selectorBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/back" style="@style/Widget.Material3.Button.TextButton" app:cornerRadius="@dimen/carbon_corner_radius" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/selectorTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Heading03" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/selectorList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/selectorEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body02" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>