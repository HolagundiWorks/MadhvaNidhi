<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_background">

    <!-- Portrait selection flow -->
    <LinearLayout
        android:id="@+id/readerMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/readerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/carbon_spacing_05"
            android:paddingTop="@dimen/carbon_spacing_04"
            android:paddingBottom="@dimen/carbon_spacing_03"
            android:background="@color/carbon_layer">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Carbon.Heading03"
                android:textColor="@color/carbon_text_primary"
                android:layout_marginBottom="@dimen/carbon_spacing_03"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/readerKalaField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kalaMorning"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/carbon_layout_size_height_lg"
                    android:contentDescription="ಪ್ರಾತಃ ಸಂಧ್ಯಾವಂದನೆ"
                    android:text="ಪ್ರಾತಃ"
                    app:cornerRadius="@dimen/carbon_corner_radius"
                    app:icon="@drawable/ic_morning" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kalaNoon"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/carbon_layout_size_height_lg"
                    android:contentDescription="ಮಾಧ್ಯಾಹ್ನಿಕ ಸಂಧ್ಯಾವಂದನೆ"
                    android:text="ಮಧ್ಯಾಹ್ನ"
                    app:cornerRadius="@dimen/carbon_corner_radius"
                    app:icon="@drawable/ic_noon" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/kalaEvening"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/carbon_layout_size_height_lg"
                    android:contentDescription="ಸಾಯಂ ಸಂಧ್ಯಾವಂದನೆ"
                    android:text="ಸಾಯಂ"
                    app:cornerRadius="@dimen/carbon_corner_radius"
                    app:icon="@drawable/ic_evening" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/readerItemField"
                style="@style/Widget.Carbon.TextInput.ExposedDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ಓದುವ ಪಠ್ಯ ಆಯ್ಕೆ"
                app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/readerItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerSelect"
                style="@style/Widget.Carbon.Button.Tertiary.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/carbon_layout_size_height_lg"
                android:text="ಆಯ್ಕೆಮಾಡಿ"
                android:visibility="gone"
                app:cornerRadius="@dimen/carbon_corner_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerSelectBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/carbon_layout_size_height_lg"
                android:text="ಆಯ್ಕೆಮಾಡಿ"
                android:visibility="gone"
                app:cornerRadius="@dimen/carbon_corner_radius" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerSelectLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/carbon_spacing_03"
                android:text=""
                android:textAppearance="@style/TextAppearance.Carbon.Body02"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/readerSubpages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subpageMantras"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/carbon_layout_size_height_lg"
                    android:text=""
                    app:cornerRadius="@dimen/carbon_corner_radius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subpageStotras"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/carbon_layout_size_height_lg"
                    android:text=""
                    app:cornerRadius="@dimen/carbon_corner_radius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/subpageSuktas"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/carbon_layout_size_height_lg"
                    android:text=""
                    app:cornerRadius="@dimen/carbon_corner_radius" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/carbon_border_width"
            android:background="@color/carbon_border_subtle" />

        <!-- Portrait Browse List (shown directly for catalogue/puja selection) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/selectorList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/carbon_spacing_04"
            android:paddingTop="@dimen/carbon_spacing_03"
            android:paddingBottom="@dimen/carbon_spacing_04" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/selectorEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/carbon_spacing_05"
            android:text=""
            android:textAppearance="@style/TextAppearance.Carbon.Body02"
            android:textColor="@color/carbon_text_secondary"
            android:visibility="gone" />

        <!-- Fallback/preview scroll when Sandhya or empty -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/readerScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/carbon_spacing_05">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/readerHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.Carbon.Heading03" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/readerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.45"
                    android:maxLines="8"
                    android:text=""
                    android:textAppearance="@style/TextAppearance.Carbon.Body02" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/carbon_border_width"
            android:background="@color/carbon_border_subtle" />

        <!-- Pinned Selection Summary + Open Content CTA -->
        <LinearLayout
            android:id="@+id/readerActionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/carbon_layer"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/carbon_spacing_05"
            android:paddingVertical="@dimen/carbon_spacing_03">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerSelectedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
                android:textColor="@color/carbon_text_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerCrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_spacing_01"
                android:layout_marginBottom="@dimen/carbon_spacing_03"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textAppearance="@style/TextAppearance.Carbon.Label01"
                android:textColor="@color/carbon_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerOpenContent"
                style="@style/Widget.Carbon.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/carbon_layout_size_height_lg"
                android:text="@string/open_content"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:icon="@drawable/ic_launch"
                app:iconGravity="textEnd"
                app:iconPadding="@dimen/carbon_spacing_03" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden legacy overlay holder kept for API compatibility -->
    <LinearLayout
        android:id="@+id/selectorPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectorBack"
            style="@style/Widget.Carbon.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/selectorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>