<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <FrameLayout
        android:id="@+id/materialContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Material 3 top app bar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/appHeader"
                style="@style/Widget.MadhvaNidhi.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/shell_toolbar_height"
                android:minHeight="@dimen/shell_toolbar_height"
                android:elevation="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/carbon_spacing_02"
                    android:paddingEnd="@dimen/carbon_spacing_04">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sidePanelToggle"
                        style="@style/Widget.MadhvaNidhi.IconButton.Standard"
                        android:layout_width="@dimen/carbon_layout_size_height_lg"
                        android:layout_height="@dimen/carbon_layout_size_height_lg"
                        android:contentDescription="Open navigation"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="@dimen/carbon_layout_size_height_lg"
                        android:minHeight="@dimen/carbon_layout_size_height_lg"
                        android:padding="0dp"
                        app:icon="@drawable/ic_open_panel_filled_left"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="@dimen/shell_nav_toggle_icon"
                        app:iconTint="@color/md_theme_onSurface" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/headerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/carbon_spacing_02"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/md_theme_onSurface" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/headerDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/carbon_spacing_03"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <View
                android:id="@+id/headerRule"
                android:layout_width="match_parent"
                android:layout_height="@dimen/carbon_border_width"
                android:background="@color/md_theme_outlineVariant" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/pageHost"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/contentControlsHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Material 3 bottom navigation bar -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@color/md_theme_surfaceContainer"
                android:elevation="0dp"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/railDestinations"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <View
            android:id="@+id/sidePanelBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/carbon_overlay"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sidePanel"
            style="@style/Widget.MadhvaNidhi.SurfaceCard.Elevated"
            android:layout_width="@dimen/shell_drawer_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:visibility="gone"
            app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/closeSidePanel"
                    style="@style/Widget.MadhvaNidhi.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/carbon_layout_size_height_lg"
                    android:contentDescription="Close navigation"
                    android:gravity="start|center_vertical"
                    android:text="ಮುಚ್ಚಿ"
                    android:textColor="@color/md_theme_onSurface"
                    app:icon="@drawable/ic_nav_prev"
                    app:iconGravity="textStart"
                    app:iconTint="@color/md_theme_onSurface" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/panelDestinations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/shell_rail_gap"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/carbon_spacing_05"
                        android:showDividers="middle" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
