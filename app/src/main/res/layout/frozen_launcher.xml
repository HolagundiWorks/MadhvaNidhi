<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <FrameLayout
        android:id="@+id/materialContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Material 3 top app bar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/appHeader"
                style="@style/Widget.MadhvaNidhi.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/shell_toolbar_height"
                android:minHeight="@dimen/shell_toolbar_height"
                android:elevation="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ds_space_4"
                    android:paddingEnd="@dimen/ds_space_4">

                    <com.google.android.material.button.MaterialButton
                        android:visibility="gone"
                        android:id="@+id/sidePanelToggle"
                        style="@style/Widget.MadhvaNidhi.IconButton"
                        android:layout_width="@dimen/ds_touch_min"
                        android:layout_height="@dimen/ds_touch_min"
                        android:contentDescription="Open navigation"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_open_panel_filled_left"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="@dimen/shell_nav_toggle_icon"
                        app:iconTint="@color/md_theme_onSurface" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/headerTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_1"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.DS.Subtitle"
                        android:textColor="@color/md_theme_onSurface" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/headerDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.DS.Caption"
                        android:textColor="@color/md_theme_onSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <View
                android:id="@+id/headerRule"
                android:layout_width="match_parent"
                android:layout_height="@dimen/md_border_width"
                android:background="@color/md_theme_outlineVariant" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/pageHost"

                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/contentControlsHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Material 3 floating bottom navigation bar: inset, rounded and elevated. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_dock_total_height"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_marginEnd="@dimen/ds_space_4"
            android:layout_marginBottom="@dimen/ds_space_4"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="horizontal"
            android:scrollbarSize="@dimen/ds_scroll_track_size"
            android:scrollbarStyle="outsideInset"
            android:scrollbarThumbHorizontal="@drawable/scroll_thumb_thin">

            <LinearLayout
                android:id="@+id/railDestinations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ds_dock_lift_space"
                android:background="@drawable/bg_floating_nav"
                android:elevation="@dimen/ds_nav_elevation"
                android:clipChildren="false"
                android:paddingStart="@dimen/ds_dock_padding"
                android:paddingEnd="@dimen/ds_dock_padding"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />
        </HorizontalScrollView>

        <!-- Raised centre Dashboard button: a true circle (oval fill, 56dp), above the dock, half over the bar's top edge. -->
        <FrameLayout
            android:id="@+id/dashboardCenterFab"
            android:layout_width="@dimen/ds_dock_center_size"
            android:layout_height="@dimen/ds_dock_center_size"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="@dimen/ds_dock_center_offset"
            android:background="@drawable/ds_dock_center_fill"
            android:clickable="true"
            android:contentDescription="Dashboard"
            android:elevation="@dimen/ds_dock_center_elevation"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/ds_size_icon"
                android:layout_height="@dimen/ds_size_icon"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dashboard"
                app:tint="@color/md_theme_onPrimary" />
        </FrameLayout>

        <View
            android:id="@+id/sidePanelBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/md_overlay"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sidePanel"
            style="@style/Widget.MadhvaNidhi.SurfaceCard.Elevated"
            android:layout_width="@dimen/shell_drawer_width"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:visibility="gone"
            app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/closeSidePanel"
                    style="@style/Widget.MadhvaNidhi.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="Close navigation"
                    android:gravity="start|center_vertical"
                    android:text="ಮುಚ್ಚಿ"
                    android:textColor="@color/md_theme_onSurface"
                    app:icon="@drawable/ic_nav_prev"
                    app:iconGravity="textStart"
                    app:iconTint="@color/md_theme_onSurface" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/panelDestinations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/shell_rail_gap"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/ds_space_4"
                        android:showDividers="middle" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</LinearLayout>
