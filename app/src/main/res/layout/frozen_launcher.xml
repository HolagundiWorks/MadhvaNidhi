<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_background">

    <FrameLayout
        android:id="@+id/materialContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Portrait Carbon UI Shell Header: menu toggle + title + date · tithi -->
            <LinearLayout
                android:id="@+id/appHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/shell_toolbar_height"
                android:minHeight="@dimen/shell_toolbar_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/carbon_spacing_02"
                android:paddingEnd="@dimen/carbon_spacing_04"
                android:background="@color/carbon_layer">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sidePanelToggle"
                    style="@style/Widget.Carbon.Button.Icon"
                    android:layout_width="@dimen/carbon_layout_size_height_lg"
                    android:layout_height="@dimen/carbon_layout_size_height_lg"
                    android:minWidth="@dimen/carbon_layout_size_height_lg"
                    android:minHeight="@dimen/carbon_layout_size_height_lg"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Open navigation"
                    app:icon="@drawable/ic_open_panel_filled_left"
                    app:iconSize="@dimen/shell_nav_toggle_icon"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/carbon_icon_primary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/headerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/carbon_spacing_02"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
                    android:textColor="@color/carbon_text_primary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/headerDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/carbon_spacing_03"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Carbon.Label01"
                    android:textColor="@color/carbon_text_secondary" />
            </LinearLayout>

            <View
                android:id="@+id/headerRule"
                android:layout_width="match_parent"
                android:layout_height="@dimen/carbon_border_width"
                android:background="@color/carbon_border_subtle" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/pageHost"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/contentControlsHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/carbon_border_width"
                android:background="@color/carbon_border_subtle" />

            <!-- Portrait Carbon Bottom Navigation Rail · 56dp height -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/shell_rail_width"
                android:background="@color/carbon_layer"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/railDestinations"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <View
            android:id="@+id/sidePanelBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/carbon_overlay"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/sidePanel"
            android:layout_width="@dimen/shell_drawer_width"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/carbon_layer"
            android:elevation="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeSidePanel"
                style="@style/Widget.Carbon.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/carbon_layout_size_height_lg"
                android:text="Navigation"
                android:textColor="@color/carbon_text_primary"
                android:contentDescription="Close navigation"
                app:icon="@drawable/ic_open_panel_filled_left"
                app:iconTint="@color/carbon_icon_primary" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/panelDestinations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:divider="@drawable/shell_rail_gap" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
