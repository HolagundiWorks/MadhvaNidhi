<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/launcherRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/carbon_background">
 <FrameLayout android:id="@+id/materialContent" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent">
   <LinearLayout android:layout_width="@dimen/shell_rail_width" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/carbon_layer">
    <com.google.android.material.button.MaterialButton android:id="@+id/sidePanelToggle" style="@style/Widget.Carbon.Button.Icon" android:layout_width="match_parent" android:layout_height="@dimen/carbon_layout_size_height_lg" android:minWidth="0dp" android:padding="0dp" android:contentDescription="Open navigation" app:icon="@drawable/ic_open_panel_filled_left" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/carbon_icon_primary" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none"><LinearLayout android:id="@+id/railDestinations" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
    <ImageView android:layout_width="48dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_madhvanidhi" android:contentDescription="@string/app_name" />
   </LinearLayout>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="48dp" android:minHeight="48dp" android:background="@color/carbon_background" app:contentInsetStart="16dp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/carbon_border" />
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/pager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <FrameLayout android:id="@+id/contentControlsHost" android:layout_width="match_parent" android:layout_height="wrap_content" />
   </LinearLayout>
  </LinearLayout>
  <View android:id="@+id/sidePanelBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/carbon_overlay" android:visibility="gone" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/sidePanel" android:layout_width="@dimen/shell_drawer_width" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/carbon_layer" android:elevation="8dp" android:visibility="gone">
   <com.google.android.material.button.MaterialButton android:id="@+id/closeSidePanel" style="@style/Widget.Carbon.Button.Ghost" android:layout_width="match_parent" android:layout_height="@dimen/carbon_layout_size_height_lg" android:text="Navigation" android:textColor="@color/carbon_text_primary" android:contentDescription="Close navigation" app:icon="@drawable/ic_open_panel_filled_left" app:iconTint="@color/carbon_icon_primary" />
   <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/panelDestinations" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
   <ImageView android:layout_width="48dp" android:layout_height="40dp" android:layout_margin="8dp" android:src="@drawable/ic_madhvanidhi" android:contentDescription="@string/app_name" />
  </LinearLayout>
 </FrameLayout>
</LinearLayout>