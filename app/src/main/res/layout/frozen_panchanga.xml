<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panchangaScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/shell_page_inset">

    <LinearLayout
        android:id="@+id/panchangaContext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingEnd="@dimen/carbon_spacing_05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/contextGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ScrollView
            android:id="@+id/contextScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="true"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/selectedDateLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ಆಯ್ದ ದಿನಾಂಕ"
                    android:textColor="@color/carbon_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/selectedDateRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/shell_control_size"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/selectedDateText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="Selected date details"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:minHeight="@dimen/shell_control_size"
                        android:textColor="@color/carbon_text"
                        android:textSize="20sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/todayDate"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="@dimen/shell_control_size"
                        android:layout_height="@dimen/shell_control_size"
                        android:contentDescription="Return to today"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        app:icon="@drawable/ic_today"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/selectedTithi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/carbon_text"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/carbon_spacing_02"
                        android:text="·"
                        android:textColor="@color/carbon_text_secondary"
                        android:textSize="14sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/selectedWeekday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/carbon_text"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Compatibility mirror for instrumentation that still reads panchangaHeader / selectedMeta -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/selectedMeta"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/carbon_spacing_03"
                    android:background="@color/carbon_border" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/shakaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ಶ್ರೀ ಶಾಲಿವಾಹನ ಗತಶಕೆ"
                    android:textColor="@color/carbon_text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/shakaYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/carbon_text"
                    android:textSize="20sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/samvatsaraText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/carbon_spacing_02"
                    android:textColor="@color/carbon_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/carbon_spacing_03"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/masaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/carbon_text"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/pakshaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/carbon_spacing_04"
                        android:textColor="@color/carbon_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/panchangaHeader"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/carbon_spacing_05"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ರಾಶಿ"
                            android:textColor="@color/carbon_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/rashiValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/carbon_spacing_01"
                            android:textColor="@color/carbon_text_helper"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/carbon_spacing_03"
                            android:text="ಭಾವ"
                            android:textColor="@color/carbon_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/bhavaValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/carbon_spacing_01"
                            android:textColor="@color/carbon_text_helper"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ನಕ್ಷತ್ರ"
                            android:textColor="@color/carbon_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/nakshatraValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/carbon_spacing_01"
                            android:textColor="@color/carbon_text"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/carbon_spacing_03"
                            android:text="ಕರಣ"
                            android:textColor="@color/carbon_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/karanaValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/carbon_spacing_01"
                            android:textColor="@color/carbon_text"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/carbon_spacing_03"
            android:background="@color/carbon_border" />

        <LinearLayout
            android:id="@+id/dayEventsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_03"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/todayEventsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ದಿನದ ವಿಶೇಷ"
                    android:textColor="@color/carbon_text_secondary"
                    android:textSize="12sp" />

                <ScrollView
                    android:id="@+id/eventScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fadeScrollbars="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/carbon_spacing_02">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/dayEvent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/carbon_text"
                            android:textSize="14sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/dayEventSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/carbon_spacing_02"
                            android:textColor="@color/carbon_text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/eventDetails"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="@dimen/shell_control_size"
                android:layout_height="@dimen/shell_control_size"
                android:contentDescription="Event details and significance"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_nav_next"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/contextGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.3" />

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/carbon_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/contextGuide"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/panchangaCalendar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/carbon_spacing_05"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/contextGuide"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/pakshaToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="@drawable/bg_paksha_toggle"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calendarPrevious"
                style="@style/Widget.MadhvaNidhi.PakshaChoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:contentDescription="Shukla paksha"
                android:text="ಶುಕ್ಲಪಕ್ಷ"
                app:icon="@drawable/ic_new_moon"
                app:iconSize="16dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/carbon_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calendarNext"
                style="@style/Widget.MadhvaNidhi.PakshaChoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:contentDescription="Krishna paksha"
                android:text="ಕೃಷ್ಣಪಕ್ಷ"
                app:icon="@drawable/ic_full_moon"
                app:iconSize="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phaseCycle"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/carbon_spacing_02"
            android:contentDescription="New moon to full moon"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/phaseMoonStart"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_new_moon"
                app:tint="@color/carbon_text_secondary" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/carbon_spacing_02"
                android:text="→"
                android:textColor="@color/carbon_text_secondary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/phaseMoonMid"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_half_moon"
                app:tint="@color/carbon_text_secondary" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/carbon_spacing_02"
                android:text="→"
                android:textColor="@color/carbon_text_secondary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/phaseMoonEnd"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_full_moon"
                app:tint="@color/carbon_text_secondary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/pakshaScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/carbon_spacing_03"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/shuklaCalendarRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/krishnaCalendarRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
