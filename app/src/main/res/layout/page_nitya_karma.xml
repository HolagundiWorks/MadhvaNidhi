<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/carbon_background">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/nityaTabs"
        style="@style/Widget.Carbon.TabLayout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/carbon_layout_size_height_md"
        android:layout_gravity="start"
        android:minHeight="@dimen/carbon_layout_size_height_md"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabInlineLabel="true" />

    <FrameLayout
        android:id="@+id/nityaPanelHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/carbon_layer" />
</LinearLayout>
