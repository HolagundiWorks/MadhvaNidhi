<?xml version="1.0" encoding="utf-8"?>
<!-- Compact milestone chip — Hick: few badges only -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_badge_chip"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="@dimen/carbon_spacing_02"
    android:paddingBottom="@dimen/carbon_spacing_02">

    <ImageView
        android:id="@+id/badgeIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:tint="@color/md_theme_onSecondaryContainer" />

    <TextView
        android:id="@+id/badgeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_spacing_01"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="@color/md_theme_onSecondaryContainer" />

    <TextView
        android:id="@+id/badgeMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
