<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/md_theme_background" android:padding="16dp">
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MadhvaNidhi.TextField.Exposed" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ನೈವೇದ್ಯ ಆಯ್ಕೆ">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/naivedyaSelector" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:inputType="none" android:textColor="@color/md_theme_onSurface" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textview.MaterialTextView android:id="@+id/naivedyaOfferingNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/md_theme_onSurfaceVariant" />
    <androidx.core.widget.NestedScrollView android:id="@+id/naivedyaScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp">
        <LinearLayout android:id="@+id/naivedyaContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
