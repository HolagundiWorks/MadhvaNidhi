<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/md_theme_background"
    android:padding="@dimen/md_spacing_05"
    android:paddingBottom="@dimen/md_spacing_07">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/md_spacing_07">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ಬಳಕೆದಾರ · User"
            android:textAppearance="@style/TextAppearance.DS.Headline"
            android:textColor="@color/md_theme_onSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md_spacing_02"
            android:text="Profile details are encrypted on this device. Use Edit · Save to update them."
            android:textAppearance="@style/TextAppearance.DS.Caption"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_6"
            android:layout_marginBottom="@dimen/ds_space_2"
            android:text="Practice preferences · ಆಚರಣೆಯ ಆಯ್ಕೆಗಳು"
            android:textAppearance="@style/TextAppearance.DS.Subtitle" />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_4"
            android:text="These preferences save automatically."
            android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" app:cardCornerRadius="@dimen/md_corner_radius" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MadhvaNidhi.Four" app:cardBackgroundColor="@color/md_theme_surfaceContainer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/md_spacing_05">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:hint="@string/settings_veda" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" app:boxCornerRadiusTopStart="@dimen/md_corner_radius" app:boxCornerRadiusTopEnd="@dimen/md_corner_radius" app:boxCornerRadiusBottomStart="@dimen/md_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/settingsVeda" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:text="@string/settings_veda_hint" android:layout_marginBottom="@dimen/md_spacing_03" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" app:cardCornerRadius="@dimen/md_corner_radius" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MadhvaNidhi.Four" app:cardBackgroundColor="@color/md_theme_surfaceContainer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/md_spacing_05">
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:hint="@string/settings_panchanga" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" app:boxCornerRadiusTopStart="@dimen/md_corner_radius" app:boxCornerRadiusTopEnd="@dimen/md_corner_radius" app:boxCornerRadiusBottomStart="@dimen/md_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/settingsPanchanga" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/settingsPanchangaHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:text="" android:layout_marginBottom="@dimen/md_spacing_03" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md_spacing_05"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/userEdit"
                style="@style/Widget.MadhvaNidhi.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/userSave"
                style="@style/Widget.MadhvaNidhi.Button.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md_spacing_03"
                android:text="Save"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/userCancel"
                style="@style/Widget.MadhvaNidhi.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/md_spacing_03"
                android:minHeight="@dimen/md_button_height"
                android:text="Cancel"
                android:visibility="gone"
                app:cornerRadius="@dimen/md_corner_radius" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/userViewMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md_spacing_05"
            android:orientation="vertical"
            android:background="@color/md_theme_surfaceContainer"
            android:padding="@dimen/md_spacing_05"
            android:paddingBottom="@dimen/md_spacing_06">

            <TextView android:id="@+id/viewNameLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Name · ಹೆಸರು" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <TextView android:id="@+id/viewName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:textAppearance="@style/TextAppearance.DS.BodySmall" android:textColor="@color/md_theme_onSurface" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gotra · ಗೋತ್ರ" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <TextView android:id="@+id/viewGotra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:textAppearance="@style/TextAppearance.DS.BodySmall" android:textColor="@color/md_theme_onSurface" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Marital · ವೈವಾಹಿಕ" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <TextView android:id="@+id/viewMarital" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:textAppearance="@style/TextAppearance.DS.BodySmall" android:textColor="@color/md_theme_onSurface" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rashi · ರಾಶಿ" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <TextView android:id="@+id/viewRashi" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:textAppearance="@style/TextAppearance.DS.BodySmall" android:textColor="@color/md_theme_onSurface" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nakshatra · ನಕ್ಷತ್ರ" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <TextView android:id="@+id/viewNakshatra" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:textAppearance="@style/TextAppearance.DS.BodySmall" android:textColor="@color/md_theme_onSurface" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Veda · ವೇದ" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <TextView android:id="@+id/viewVeda" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:textAppearance="@style/TextAppearance.DS.BodySmall" android:textColor="@color/md_theme_onSurface" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Matha · ಮಠ" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <TextView android:id="@+id/viewMatha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:textAppearance="@style/TextAppearance.DS.BodySmall" android:textColor="@color/md_theme_onSurface" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/md_spacing_05" android:text="Japa / diksha · ಜಪ ದೀಕ್ಷಾ" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <TextView android:id="@+id/viewDiksha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/md_spacing_05" android:textAppearance="@style/TextAppearance.DS.BodySmall" android:textColor="@color/md_theme_onSurface" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Japa targets · ಜಪ ಗುರಿ" android:textAppearance="@style/TextAppearance.DS.Caption" android:textColor="@color/md_theme_onSurfaceVariant" />
            <LinearLayout android:id="@+id/viewJapaTargets" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/userEditMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md_spacing_05"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name · ಹೆಸರು"
                style="@style/Widget.Material3.TextInputLayout.FilledBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_spacing_03"
                android:hint="Gotra · ಗೋತ್ರ"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/editGotra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_spacing_03"
                android:hint="Marital · ವೈವಾಹಿಕ"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/editMarital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_spacing_03"
                android:hint="Rashi"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/editRashi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_spacing_03"
                android:hint="Nakshatra"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/editNakshatra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_spacing_03"
                android:hint="Veda"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/editVeda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_spacing_03"
                android:hint="Matha"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/editMatha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_spacing_05"
                android:hint="Japa / diksha · ಜಪ ದೀಕ್ಷಾ"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/editDiksha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:hint="Choose mantras for japa" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/editDikshaHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/md_spacing_05"
                android:text="Japa targets"
                android:textAppearance="@style/TextAppearance.DS.Caption"
                android:textColor="@color/md_theme_onSurfaceVariant" />

            <LinearLayout
                android:id="@+id/editJapaTargetsHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/md_spacing_03" />
        </LinearLayout>

        <TextView
            android:id="@+id/userStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md_spacing_05"
            android:textAppearance="@style/TextAppearance.DS.Caption"
            android:textColor="@color/md_theme_onSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
