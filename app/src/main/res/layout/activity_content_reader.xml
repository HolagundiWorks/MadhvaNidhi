<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/readerActivityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <!-- Landscape Reader Toolbar: Back to menu + Title/Crumb + Text Size A- / % / A+ -->
    <LinearLayout
        android:id="@+id/readerToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/md_layout_size_height_lg"
        android:background="@color/md_theme_surfaceContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_2"
        android:paddingEnd="@dimen/ds_space_4"
        android:paddingTop="@dimen/ds_space_1"
        android:paddingBottom="@dimen/ds_space_1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readerMenuBack"
            style="@style/Widget.MadhvaNidhi.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/md_layout_size_height_lg"
            android:paddingStart="@dimen/ds_space_2"
            android:paddingEnd="@dimen/ds_space_3"
            android:text="@string/back_to_menu"
            android:contentDescription="@string/back_to_menu"
            app:cornerRadius="@dimen/md_corner_radius"
            app:icon="@drawable/ic_nav_prev"
            app:iconPadding="@dimen/ds_space_1"
            app:iconTint="@color/md_theme_onSurface" />

        <View
            android:layout_width="@dimen/md_border_width"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/ds_space_1"
            android:layout_marginEnd="@dimen/ds_space_3"
            android:background="@color/md_theme_outlineVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerContentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.DS.Subtitle"
                android:textColor="@color/md_theme_onSurface" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerContentCrumb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.DS.Caption"
                android:textColor="@color/md_theme_onSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readerSongFavorite"
            style="@style/Widget.MadhvaNidhi.IconButton"
            android:layout_width="@dimen/ds_touch_min" android:layout_height="@dimen/ds_touch_min"
            android:minWidth="48dp" android:padding="0dp" android:visibility="gone"
            app:icon="@drawable/ic_favorite_outline" app:iconPadding="0dp"
            app:iconGravity="textStart" app:iconTint="@color/md_theme_onSurface"/>

        <LinearLayout
            android:id="@+id/readerFontControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerFontDecrease"
                style="@style/Widget.MadhvaNidhi.IconButton"
                android:layout_width="@dimen/ds_touch_min"
                android:layout_height="@dimen/ds_touch_min"
                android:contentDescription="@string/text_smaller"
                app:cornerRadius="@dimen/md_corner_radius"
                app:icon="@drawable/ic_text_smaller"
                app:iconSize="20dp"
                app:iconTint="@color/md_theme_onSurface"
                app:strokeColor="@color/md_theme_outline"
                app:strokeWidth="@dimen/md_border_width"
                app:iconPadding="0dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerFontSizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:gravity="center"
                android:paddingHorizontal="@dimen/ds_space_1"
                android:text="100%"
                android:textAppearance="@style/TextAppearance.DS.Caption"
                android:textColor="@color/md_theme_onSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/readerFontIncrease"
                style="@style/Widget.MadhvaNidhi.IconButton"
                android:layout_width="@dimen/ds_touch_min"
                android:layout_height="@dimen/ds_touch_min"
                android:contentDescription="@string/text_larger"
                app:cornerRadius="@dimen/md_corner_radius"
                app:icon="@drawable/ic_text_larger"
                app:iconSize="20dp"
                app:iconTint="@color/md_theme_onSurface"
                app:strokeColor="@color/md_theme_outline"
                app:strokeWidth="@dimen/md_border_width"
                app:iconPadding="0dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_border_width"
        android:background="@color/md_theme_outlineVariant" />

    <!-- Optional stepped ritual bar (Sandhya / Puja) -->
    <LinearLayout
        android:id="@+id/readerStepBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surfaceContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_4"
        android:paddingTop="@dimen/ds_space_1"
        android:paddingBottom="@dimen/ds_space_1"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readerStepPrev"
            style="@style/Widget.MadhvaNidhi.IconButton"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:contentDescription="Previous step"
            app:cornerRadius="@dimen/md_corner_radius"
            app:icon="@drawable/ic_nav_prev"
            app:iconTint="@color/md_theme_onSurface"
                app:iconPadding="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/ds_space_3"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.DS.BodyMedium"
                android:textColor="@color/md_theme_onSurface" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/readerStepProgress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ds_space_1"
                android:layout_marginTop="@dimen/ds_space_1"
                android:max="100"
                android:progress="25"
                app:indicatorColor="@color/ds_progress_indicator"
                app:trackColor="@color/ds_progress_track"
                app:trackCornerRadius="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readerStepNext"
            style="@style/Widget.MadhvaNidhi.IconButton"
            android:layout_width="@dimen/ds_touch_min"
            android:layout_height="@dimen/ds_touch_min"
            android:contentDescription="Next step"
            app:cornerRadius="@dimen/md_corner_radius"
            app:icon="@drawable/ic_nav_next"
            app:iconTint="@color/md_theme_onSurface"
                app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readerStepAll"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/md_button_height"
            android:layout_marginStart="@dimen/ds_space_2"
            android:paddingHorizontal="@dimen/ds_space_2"
            android:text="ಸಂಪೂರ್ಣ"
            app:cornerRadius="@dimen/md_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readerModeSkip"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="@dimen/md_layout_size_height_lg"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_2"
            android:contentDescription="Skip today"
            app:cornerRadius="@dimen/md_corner_radius"
            app:icon="@drawable/ic_skip"
            app:iconTint="@color/md_theme_onSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/readerModeComplete"
            style="@style/Widget.MadhvaNidhi.Button.Outlined"
            android:layout_width="@dimen/md_layout_size_height_lg"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_1"
            android:contentDescription="Completed for today"
            app:cornerRadius="@dimen/md_corner_radius"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/md_theme_onSurfaceVariant" />
    </LinearLayout>

    <!-- Optional Japa Anga switcher -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/readerAngaTabs"
        style="@style/Widget.Material3.TabLayout.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_layout_size_height_md"
        android:visibility="gone"
        app:tabGravity="start"
        app:tabMode="scrollable" />

    <View
        android:id="@+id/readerModeDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_border_width"
        android:background="@color/md_theme_outlineVariant"
        android:visibility="gone" />

    <!-- Scrollable landscape reading area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/readerContentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ds_space_8"
            android:paddingVertical="@dimen/ds_space_4">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerContentHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_3"
                android:textAppearance="@style/TextAppearance.DS.Headline"
                android:textColor="@color/md_theme_primary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/readerContentBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_10"
                android:textAppearance="@style/TextAppearance.DS.Body"
                android:textColor="@color/md_theme_onSurface"
                android:textIsSelectable="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
