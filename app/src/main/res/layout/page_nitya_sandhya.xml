<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/md_theme_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:showDividers="none">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಸಂಧ್ಯಾವಂದನೆ" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" android:textColor="@color/md_theme_onSurface" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಆಚರಣೆಯ ಸಮಯ ಆಯ್ಕೆಮಾಡಿ" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/md_theme_onSurface" />
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/sandhyaKalaPratah" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="ಬೆಳಗ್ಗೆ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" app:icon="@drawable/ic_morning" app:iconSize="24dp" app:iconGravity="textTop" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sandhyaKalaMadhya" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="ಮಧ್ಯಾಹ್ನ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" app:icon="@drawable/ic_noon" app:iconSize="24dp" app:iconGravity="textTop" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sandhyaKalaSayam" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="ಸಂಜೆ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" app:icon="@drawable/ic_evening" app:iconSize="24dp" app:iconGravity="textTop" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/sandhyaRead" style="@style/Widget.MadhvaNidhi.Button.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="ಸಂಧ್ಯಾವಂದನೆ ತೆರೆಯಿರಿ" android:textSize="16sp" android:textColor="@color/md_theme_onPrimary" app:cornerRadius="16dp" app:icon="@drawable/ic_nav_library" app:iconSize="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಪಾಠವು ಅಡ್ಡ ಪರದೆಯಲ್ಲಿ ತೆರೆಯುತ್ತದೆ" android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="@color/md_theme_onSurface" />
        <Space android:layout_width="1dp" android:layout_height="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/sandhyaPracticeStatus" android:text="ಆಚರಣೆ ಬಾಕಿ · Not marked complete" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:textColor="@color/md_theme_onSurface" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/sandhyaSkip" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="ಇಂದು ಬಿಟ್ಟಿದೆ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" app:icon="@drawable/ic_skip" app:iconSize="24dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/sandhyaComplete" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="ಇಂದು ಪೂರ್ಣ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" app:icon="@drawable/ic_check" app:iconSize="24dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>