<?xml version="1.0" encoding="utf-8"?>
<!-- Frozen Sandhyavandana · pathya+kala+skip/complete one row · float progress 50% -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/carbon_layout_size_height_md"
        android:paddingStart="@dimen/carbon_spacing_05"
        android:paddingEnd="@dimen/carbon_spacing_05"
        android:paddingTop="@dimen/carbon_spacing_03"
        android:paddingBottom="@dimen/carbon_spacing_03"
        android:background="@color/md_theme_surfaceContainer">

        <!-- Actions first so pathya can layout_toStartOf them (mockup single toolbar row). -->
        <LinearLayout
            android:id="@+id/sandhyaToolbarActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/carbon_spacing_07"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sandhyaKalaPratah"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:theme="@style/ThemeOverlay.Material3.Button"
                android:layout_width="@dimen/carbon_layout_size_height_lg"
                android:layout_height="@dimen/carbon_layout_size_height_lg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="ಪ್ರಾತಃ"
                app:icon="@drawable/ic_morning"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/md_theme_onSurfaceVariant"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:strokeColor="@color/md_theme_outline"
                app:strokeWidth="@dimen/carbon_border_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sandhyaKalaMadhya"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:theme="@style/ThemeOverlay.Material3.Button"
                android:layout_width="@dimen/carbon_layout_size_height_lg"
                android:layout_height="@dimen/carbon_layout_size_height_lg"
                android:layout_marginStart="@dimen/carbon_spacing_03"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="ಮಧ್ಯಾಹ್ನ"
                app:icon="@drawable/ic_noon"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/md_theme_onSurfaceVariant"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:strokeColor="@color/md_theme_outline"
                app:strokeWidth="@dimen/carbon_border_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sandhyaKalaSayam"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:theme="@style/ThemeOverlay.Material3.Button"
                android:layout_width="@dimen/carbon_layout_size_height_lg"
                android:layout_height="@dimen/carbon_layout_size_height_lg"
                android:layout_marginStart="@dimen/carbon_spacing_03"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="ಸಾಯಂ"
                app:icon="@drawable/ic_evening"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/md_theme_onSurfaceVariant"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:strokeColor="@color/md_theme_outline"
                app:strokeWidth="@dimen/carbon_border_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sandhyaSkip"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:theme="@style/ThemeOverlay.Material3.Button"
                android:layout_width="@dimen/carbon_layout_size_height_lg"
                android:layout_height="@dimen/carbon_layout_size_height_lg"
                android:layout_marginStart="@dimen/carbon_spacing_05"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="Skip today"
                app:icon="@drawable/ic_skip"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/md_theme_onSurfaceVariant"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:strokeColor="@color/md_theme_outline"
                app:strokeWidth="@dimen/carbon_border_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sandhyaComplete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:theme="@style/ThemeOverlay.Material3.Button"
                android:layout_width="@dimen/carbon_layout_size_height_lg"
                android:layout_height="@dimen/carbon_layout_size_height_lg"
                android:layout_marginStart="@dimen/carbon_spacing_03"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:contentDescription="Completed for today"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/md_theme_onSurfaceVariant"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:strokeColor="@color/md_theme_outline"
                app:strokeWidth="@dimen/carbon_border_width" />
        </LinearLayout>

        <TextView
            android:id="@+id/sandhyaPathy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/sandhyaToolbarActions"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="@dimen/carbon_spacing_05"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="@color/md_theme_onSurface"
            android:text="ಆಚಮನ" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/md_theme_background">

        <ScrollView
            android:id="@+id/sandhyaScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/carbon_spacing_09">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/carbon_spacing_05">

                <TextView
                    android:id="@+id/sandhyaCrumb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:text="ನಿತ್ಯಕರ್ಮ · ಸಂಧ್ಯಾವಂದನೆ" />

                <TextView
                    android:id="@+id/sandhyaBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/carbon_spacing_05"
                    android:lineSpacingMultiplier="1.43"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/md_theme_onSurface"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>

        <!-- 48dp hit target; visual bar stays carbon_spacing_03 @ 50% opacity (Fitts). -->
        <FrameLayout
            android:id="@+id/sandhyaProgressHit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/carbon_layout_size_height_lg"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/carbon_spacing_05"
            android:layout_marginEnd="@dimen/carbon_spacing_05"
            android:layout_marginBottom="@dimen/carbon_spacing_03"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Pathya progress · tap next · long-press previous">

            <ProgressBar
                android:id="@+id/sandhyaProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/carbon_spacing_03"
                android:layout_gravity="center_vertical"
                android:alpha="0.5"
                android:max="100"
                android:progress="25"
                android:progressDrawable="@drawable/carbon_progress_horizontal"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
