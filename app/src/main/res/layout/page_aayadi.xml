<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ds_space_4">
        <GridLayout android:id="@+id/aayadiGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="1" android:alignmentMode="alignMargins" android:useDefaultMargins="false">

            <!-- 1. Header: one purpose, one help control -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="@dimen/ds_space_4">
                <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Title" android:text="ಆಯಾದಿ ಲೆಕ್ಕ" />
                <com.google.android.material.button.MaterialButton android:id="@+id/aayadiInfo" style="@style/Widget.MadhvaNidhi.Button.Text" android:layout_width="@dimen/md_layout_size_height_lg" android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp" android:padding="0dp" android:contentDescription="ಆಯಾದಿ ಮಾಹಿತಿ" app:icon="@drawable/ic_information" app:iconGravity="textStart" app:iconPadding="0dp" app:cornerRadius="@dimen/md_corner_radius" />
            </LinearLayout>

            <!-- 2. Input: the only thing the user must do. Each dimension is one row: feet, then inches. -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ds_space_6" app:cardCornerRadius="@dimen/md_corner_radius" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MadhvaNidhi.Four" app:cardBackgroundColor="@color/md_theme_surfaceContainer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ds_space_4">
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:text="ಕಟ್ಟಡದ ಅಳತೆ" android:layout_marginBottom="@dimen/ds_space_2" />
                    <GridLayout android:id="@+id/aayadiInputsGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:alignmentMode="alignMargins" android:useDefaultMargins="false">
                        <com.google.android.material.textview.MaterialTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:gravity="center_vertical" android:layout_gravity="center_vertical" android:textAppearance="@style/TextAppearance.DS.BodyMedium" android:text="ಉದ್ದ" android:layout_marginEnd="@dimen/ds_space_2" />
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/ds_space_2" android:hint="ಅಡಿ" style="@style/Widget.MadhvaNidhi.TextInput.Outlined" app:boxCornerRadiusTopStart="@dimen/md_corner_radius" app:boxCornerRadiusTopEnd="@dimen/md_corner_radius" app:boxCornerRadiusBottomStart="@dimen/md_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/aayadiLengthFt" android:contentDescription="ಉದ್ದ, ಅಡಿ" android:textAppearance="@style/TextAppearance.DS.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:maxLines="1" android:maxLength="6" android:imeOptions="actionDone" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:hint="ಇಂಚು" style="@style/Widget.MadhvaNidhi.TextInput.ExposedDropdown" app:boxCornerRadiusTopStart="@dimen/md_corner_radius" app:boxCornerRadiusTopEnd="@dimen/md_corner_radius" app:boxCornerRadiusBottomStart="@dimen/md_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/aayadiLengthIn" android:contentDescription="ಉದ್ದ, ಇಂಚು" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="none" android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textview.MaterialTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:gravity="center_vertical" android:layout_gravity="center_vertical" android:textAppearance="@style/TextAppearance.DS.BodyMedium" android:text="ಅಗಲ" android:layout_marginEnd="@dimen/ds_space_2" android:layout_marginTop="@dimen/ds_space_2" />
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/ds_space_2" android:layout_marginTop="@dimen/ds_space_2" android:hint="ಅಡಿ" style="@style/Widget.MadhvaNidhi.TextInput.Outlined" app:boxCornerRadiusTopStart="@dimen/md_corner_radius" app:boxCornerRadiusTopEnd="@dimen/md_corner_radius" app:boxCornerRadiusBottomStart="@dimen/md_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/aayadiBreadthFt" android:contentDescription="ಅಗಲ, ಅಡಿ" android:textAppearance="@style/TextAppearance.DS.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:maxLines="1" android:maxLength="6" android:imeOptions="actionDone" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ds_space_2" android:hint="ಇಂಚು" style="@style/Widget.MadhvaNidhi.TextInput.ExposedDropdown" app:boxCornerRadiusTopStart="@dimen/md_corner_radius" app:boxCornerRadiusTopEnd="@dimen/md_corner_radius" app:boxCornerRadiusBottomStart="@dimen/md_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/aayadiBreadthIn" android:contentDescription="ಅಗಲ, ಇಂಚು" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="none" android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </GridLayout>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiError" android:textColor="@color/md_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Body" android:text="ಸರಿಯಾದ ಉದ್ದ ಮತ್ತು ಅಗಲ ಆಯ್ಕೆಮಾಡಿ" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Configuration problem: shown above the results, never hidden inside them -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/aayadiConfigCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ds_space_4" android:visibility="gone" app:cardCornerRadius="@dimen/md_corner_radius" app:cardBackgroundColor="@color/md_theme_errorContainer">
                <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiConfigError" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/ds_space_4" android:textColor="@color/md_theme_onErrorContainer" android:textAppearance="@style/TextAppearance.DS.Body" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Section A: the entered size, its verdict, then the parameters -->
            <LinearLayout android:id="@+id/aayadiSectionA" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="@dimen/ds_space_6">
                <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiSectionAHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Title" android:text="ನೀಡಿದ ಅಳತೆ" android:layout_marginBottom="@dimen/ds_space_2" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="@dimen/md_corner_radius" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MadhvaNidhi.Four" app:cardBackgroundColor="@color/md_theme_surfaceContainer">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ds_space_4">
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiOriginalDims" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Headline" />
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiOriginalHasta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:layout_marginBottom="@dimen/ds_space_4" />
                        <!-- Verdict first: the chip and the sentence say the same thing, so colour is never the only signal -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:id="@+id/aayadiVerdictChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="96dp" android:gravity="center" android:paddingStart="@dimen/ds_space_3" android:paddingEnd="@dimen/ds_space_3" android:paddingTop="@dimen/ds_space_2" android:paddingBottom="@dimen/ds_space_2" android:textAppearance="@style/TextAppearance.DS.LabelLarge" />
                            <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiVerdictText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ds_space_3" android:textAppearance="@style/TextAppearance.DS.BodyMedium" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/md_theme_outlineVariant" android:layout_marginTop="@dimen/ds_space_4" android:layout_marginBottom="@dimen/ds_space_2" />
                        <LinearLayout android:id="@+id/aayadiParamList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/aayadiWorkingToggle" style="@style/Widget.MadhvaNidhi.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="ಲೆಕ್ಕದ ವಿವರ ತೋರಿಸಿ" android:layout_marginTop="@dimen/ds_space_2" />
                        <LinearLayout android:id="@+id/aayadiWorking" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiWorkingText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 4. Section B: the recommended sizes, closest first, one card each -->
            <LinearLayout android:id="@+id/aayadiSectionB" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiSectionBHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Title" android:text="ಶಿಫಾರಸು ಮಾಡಿದ ಅಳತೆ" android:layout_marginBottom="@dimen/ds_space_1" />
                <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiRecommendSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:layout_marginBottom="@dimen/ds_space_3" />
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/aayadiSortGroup" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" android:layout_marginBottom="@dimen/ds_space_3">
                    <com.google.android.material.button.MaterialButton android:id="@+id/aayadiSortClosest" style="@style/Widget.MadhvaNidhi.Button.Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="ಹತ್ತಿರ" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/aayadiSortArea" style="@style/Widget.MadhvaNidhi.Button.Text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="ದೊಡ್ಡ ವಿಸ್ತೀರ್ಣ" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <LinearLayout android:id="@+id/aayadiCandidateList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <com.google.android.material.card.MaterialCardView android:id="@+id/aayadiEmptyCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:cardCornerRadius="@dimen/md_corner_radius" app:cardBackgroundColor="@color/md_theme_surfaceContainer">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ds_space_4">
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/aayadiEmptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.BodyMedium" />
                        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:text="ಬೇರೆ ಅಳತೆ ನಮೂದಿಸಿ ಪ್ರಯತ್ನಿಸಿ." android:layout_marginTop="@dimen/ds_space_2" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </GridLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
