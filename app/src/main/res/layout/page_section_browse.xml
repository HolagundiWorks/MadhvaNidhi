<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <!-- Portrait section selection list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surfaceContainer"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_4"
        android:paddingTop="@dimen/ds_space_3"
        android:paddingBottom="@dimen/ds_space_2">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.DS.Headline"
            android:textColor="@color/md_theme_onSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_half"
            android:textAppearance="@style/TextAppearance.DS.BodyMedium"
            android:textColor="@color/md_theme_onSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_border_width"
        android:background="@color/md_theme_outlineVariant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sectionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/ds_space_3"
        android:paddingVertical="@dimen/ds_space_2" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/md_border_width"
        android:background="@color/md_border" />

    <!-- Selection details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surfaceContainer"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ds_space_4"
        android:paddingVertical="@dimen/ds_space_2">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.DS.Subtitle"
            android:textColor="@color/md_theme_onSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionDetailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_half"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.DS.BodyMedium"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sectionAction"
                style="@style/Widget.MadhvaNidhi.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_2"
                android:minHeight="@dimen/md_button_height"
                android:visibility="gone"
                app:cornerRadius="@dimen/md_corner_radius" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
