<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <!-- Portrait section selection list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surfaceContainer"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/carbon_spacing_05"
        android:paddingTop="@dimen/carbon_spacing_04"
        android:paddingBottom="@dimen/carbon_spacing_03">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="@color/md_theme_onSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_01"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/md_theme_onSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/carbon_border_width"
        android:background="@color/md_theme_outlineVariant" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sectionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/carbon_spacing_04"
        android:paddingVertical="@dimen/carbon_spacing_03" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/carbon_border_width"
        android:background="@color/carbon_border" />

    <!-- Selection details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surfaceContainer"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/carbon_spacing_05"
        android:paddingVertical="@dimen/carbon_spacing_03">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/md_theme_onSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionDetailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_01"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_03"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sectionAction"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/carbon_spacing_03"
                android:minHeight="@dimen/carbon_layout_size_height_lg"
                android:visibility="gone"
                app:cornerRadius="@dimen/carbon_corner_radius" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
