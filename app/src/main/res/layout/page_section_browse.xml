<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_background"
    android:orientation="vertical">

    <!-- Portrait section selection list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/carbon_layer"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/carbon_spacing_05"
        android:paddingTop="@dimen/carbon_spacing_04"
        android:paddingBottom="@dimen/carbon_spacing_03">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Carbon.Heading03"
            android:textColor="@color/carbon_text" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_01"
            android:textAppearance="@style/TextAppearance.Carbon.Body01"
            android:textColor="@color/carbon_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/carbon_border_width"
        android:background="@color/carbon_border_subtle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sectionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/carbon_spacing_04"
        android:paddingVertical="@dimen/carbon_spacing_03" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/carbon_border_width"
        android:background="@color/carbon_border" />

    <!-- Pinned selection preview + Open Content CTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/carbon_layer"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/carbon_spacing_05"
        android:paddingVertical="@dimen/carbon_spacing_03">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
            android:textColor="@color/carbon_text" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sectionDetailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_01"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.Carbon.Body01"
            android:textColor="@color/carbon_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_03"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sectionAction"
                style="@style/Widget.Carbon.Button.Tertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/carbon_spacing_03"
                android:minHeight="@dimen/carbon_layout_size_height_lg"
                android:visibility="gone"
                app:cornerRadius="@dimen/carbon_corner_radius" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sectionOpenContent"
                style="@style/Widget.Carbon.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/carbon_layout_size_height_lg"
                android:text="@string/open_content"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:icon="@drawable/ic_launch"
                app:iconGravity="textEnd"
                app:iconPadding="@dimen/carbon_spacing_03" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
