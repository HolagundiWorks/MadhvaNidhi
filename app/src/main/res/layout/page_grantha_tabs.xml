<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <!-- Hub title is hidden: the shared app header shows the destination title on every page. -->
    <TextView
        android:id="@+id/hubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingStart="@dimen/md_spacing_05"
        android:paddingEnd="@dimen/md_spacing_05"
        android:paddingTop="@dimen/md_spacing_03"
        android:paddingBottom="@dimen/md_spacing_02"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/md_theme_onSurface"
        android:maxLines="1"
        android:ellipsize="end" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/granthaTabs"
        style="@style/Widget.MadhvaNidhi.TabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:minHeight="48dp"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabInlineLabel="true" />

    <FrameLayout
        android:id="@+id/granthaPanelHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/md_theme_background" />
</LinearLayout>
