<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ds_space_4" android:paddingBottom="@dimen/ds_space_8">
        <com.google.android.material.button.MaterialButton android:id="@+id/settingsBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/md_button_height" android:text="@string/back" style="@style/Widget.MadhvaNidhi.Button.Text" app:cornerRadius="@dimen/md_corner_radius" />
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Headline" android:text="@string/settings_title" android:layout_marginBottom="@dimen/ds_space_2" android:id="@+id/settingsPageTitle" />
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Body" android:text="@string/settings_summary" android:visibility="gone" android:layout_marginBottom="@dimen/ds_space_2" />
        <GridLayout android:id="@+id/settingsGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="1" android:alignmentMode="alignMargins" android:useDefaultMargins="false">

            <com.google.android.material.card.MaterialCardView android:id="@+id/settingsProfileCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ds_space_4" app:cardCornerRadius="@dimen/md_corner_radius" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MadhvaNidhi.Four" app:cardBackgroundColor="@color/md_theme_surfaceContainer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ds_space_4">
                    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_register_title" android:textAppearance="@style/TextAppearance.DS.Title" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/settingsProfileSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:layout_marginTop="@dimen/ds_space_2" android:text="@string/profile_summary_empty" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/settingsOpenProfile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="@dimen/md_button_height" android:layout_marginTop="@dimen/ds_space_2" android:text="@string/profile_open" app:cornerRadius="@dimen/md_corner_radius" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ds_space_4" app:cardCornerRadius="@dimen/md_corner_radius" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MadhvaNidhi.Four" app:cardBackgroundColor="@color/md_theme_surfaceContainer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ds_space_4">
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/settingsThemeSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Dark theme · ಡಾರ್ಕ್ ಥೀಮ್"
                        app:thumbIcon="@drawable/theme_switch_icon"
                        app:thumbIconSize="16dp" />
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/ds_space_4" android:hint="Language · ಭಾಷೆ" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" app:boxCornerRadiusTopStart="@dimen/md_corner_radius" app:boxCornerRadiusTopEnd="@dimen/md_corner_radius" app:boxCornerRadiusBottomStart="@dimen/md_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/settingsLang" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:maxLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/ds_space_4" app:cardCornerRadius="@dimen/md_corner_radius" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MadhvaNidhi.Four" app:cardBackgroundColor="@color/md_theme_surfaceContainer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/ds_space_4">
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/settingsAlwaysOn" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/md_layout_size_height_lg" android:text="ಪರದೆ ಸದಾ ಆನ್" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.BodyMedium" android:textColor="@color/md_theme_onSurfaceVariant" android:lineSpacingExtra="4dp" android:layout_marginTop="@dimen/ds_space_4" android:text="@string/brand_developer" android:layout_marginBottom="@dimen/ds_space_2" />
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:text="@string/brand_made_in" android:layout_marginBottom="@dimen/ds_space_2" />
        <com.google.android.material.textview.MaterialTextView android:id="@+id/settingsVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:text="" android:layout_marginBottom="@dimen/ds_space_2" />
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Caption" android:text="@string/legal_footer_hint" android:layout_marginBottom="@dimen/ds_space_2" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>