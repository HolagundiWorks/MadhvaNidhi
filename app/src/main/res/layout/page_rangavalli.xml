<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/md_theme_background" android:padding="@dimen/ds_space_4">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ರಂಗವಲ್ಲಿ · ರೇಖಾ ವಿನ್ಯಾಸಗಳು" android:textAppearance="@style/TextAppearance.DS.Title" android:textColor="@color/md_theme_onSurface" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ವಿನ್ಯಾಸವನ್ನು ಸ್ಪರ್ಶಿಸಿ ದೊಡ್ಡ ಚಿತ್ರ ಮತ್ತು ವಿಧಾನ ನೋಡಿ" android:textAppearance="@style/TextAppearance.DS.BodyMedium" android:textColor="@color/md_theme_onSurfaceVariant" android:layout_marginTop="@dimen/ds_space_2" />
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MadhvaNidhi.TextField.Exposed" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ವಿನ್ಯಾಸದ ವಿಧ" android:layout_marginTop="@dimen/ds_space_4">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/rangavalliFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none" android:textColor="@color/md_theme_onSurface" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/rangavalliCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.DS.Label" android:textColor="@color/md_theme_onSurfaceVariant" android:layout_marginTop="@dimen/ds_space_3" android:layout_marginBottom="@dimen/ds_space_2" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rangavalliGrid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="@dimen/ds_space_2" />
</LinearLayout>
