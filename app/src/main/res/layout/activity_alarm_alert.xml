<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/carbon_spacing_07">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/alertTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Carbon.Heading05"
        android:textColor="@color/carbon_text" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/alertLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_spacing_03"
        android:textAppearance="@style/TextAppearance.Carbon.Heading02"
        android:textColor="@color/carbon_interactive" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/alertDismiss"
        style="@style/Widget.Carbon.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_spacing_09"
        android:text="@string/dismiss"
        app:cornerRadius="@dimen/carbon_corner_radius" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/alertSnooze"
        style="@style/Widget.Carbon.Button.Tertiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/carbon_spacing_04"
        android:text="@string/snooze"
        app:cornerRadius="@dimen/carbon_corner_radius" />
</LinearLayout>
