<?xml version="1.0" encoding="utf-8"?>
<!-- Practice dashboard · 5×3 grid parity with prototypes/app-shell; row 2 = japa slots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/practiceDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_background"
    android:orientation="vertical"
    android:padding="@dimen/carbon_spacing_03">

    <!-- Row 1: week (4) + streak (1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dashWeek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:background="@color/carbon_layer"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03">

            <TextView
                android:id="@+id/dashWeekTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ಸಂಧ್ಯಾವಂದನೆ · Weekly overview"
                android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
                android:textColor="@color/carbon_text" />

            <LinearLayout
                android:id="@+id/dashboardWeek"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/carbon_spacing_02"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashStreak"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/carbon_spacing_03"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_02">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current streak"
                    android:textAppearance="@style/TextAppearance.Carbon.Label01"
                    android:textColor="@color/carbon_text_secondary" />

                <TextView
                    android:id="@+id/dashStreakCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 days"
                    android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
                    android:textColor="@color/carbon_text" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/carbon_border_width"
                android:background="@color/carbon_border_subtle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best streak"
                    android:textAppearance="@style/TextAppearance.Carbon.Label01"
                    android:textColor="@color/carbon_text_secondary" />

                <TextView
                    android:id="@+id/dashStreakBest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 days"
                    android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
                    android:textColor="@color/carbon_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Gayatri + 4 customizable japa slots -->
    <LinearLayout
        android:id="@+id/dashboardJapaRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/carbon_spacing_03"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dashboardJapaSlot0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03" />

        <LinearLayout
            android:id="@+id/dashboardJapaSlot1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/carbon_spacing_03"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03" />

        <LinearLayout
            android:id="@+id/dashboardJapaSlot2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/carbon_spacing_03"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03" />

        <LinearLayout
            android:id="@+id/dashboardJapaSlot3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/carbon_spacing_03"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03" />

        <LinearLayout
            android:id="@+id/dashboardJapaSlot4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/carbon_spacing_03"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03" />
    </LinearLayout>

    <!-- Row 3: 3 customizable shortcut panels + daily progress (2) -->
    <LinearLayout
        android:id="@+id/dashboardBottomRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/carbon_spacing_03"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/dashboardShortcut0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ತ್ವರಿತ"
                android:textAppearance="@style/TextAppearance.Carbon.Label01"
                android:textColor="@color/carbon_text_secondary" />

            <TextView
                android:id="@+id/dashboardShortcutLabel0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_spacing_02"
                android:text="ಪಂಚಾಂಗ"
                android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
                android:textColor="@color/carbon_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashboardShortcut1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/carbon_spacing_03"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ತ್ವರಿತ"
                android:textAppearance="@style/TextAppearance.Carbon.Label01"
                android:textColor="@color/carbon_text_secondary" />

            <TextView
                android:id="@+id/dashboardShortcutLabel1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_spacing_02"
                android:text="ಜಪ"
                android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
                android:textColor="@color/carbon_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashboardShortcut2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/carbon_spacing_03"
            android:layout_weight="1"
            android:background="@color/carbon_layer"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_03">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ತ್ವರಿತ"
                android:textAppearance="@style/TextAppearance.Carbon.Label01"
                android:textColor="@color/carbon_text_secondary" />

            <TextView
                android:id="@+id/dashboardShortcutLabel2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/carbon_spacing_02"
                android:text="ಗ್ರಂಥ"
                android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
                android:textColor="@color/carbon_text" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dashProgress"
            style="@style/Widget.Carbon.Button.Tertiary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/carbon_spacing_03"
            android:layout_weight="2"
            android:backgroundTint="@color/carbon_layer"
            android:gravity="start|bottom"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="@dimen/carbon_spacing_03"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="ದಿನದ ಅಭ್ಯಾಸ · Daily progress"
            android:textAppearance="@style/TextAppearance.Carbon.HeadingCompact01"
            android:textColor="@color/carbon_text"
            app:cornerRadius="@dimen/carbon_corner_radius"
            app:strokeWidth="0dp" />
    </LinearLayout>
</LinearLayout>
