<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_6">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dateDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="@dimen/ds_type_xl" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_4"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/ds_space_2"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ವಾರ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogWeekday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ಪಕ್ಷ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogPhase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/ds_space_2"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ತಿಥಿ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogTithi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ಮಾಸ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogMasa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/ds_space_2"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ರಾಶಿ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogRashi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_text_helper"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ನಕ್ಷತ್ರ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogNakshatra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/ds_space_2"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ನಕ್ಷತ್ರ ಪಾದ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogBhava"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_text_helper"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ಕರಣ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogKarana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_columnSpan="2"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ಯೋಗ"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:textSize="@dimen/ds_type_xs" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/dateDialogYoga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="@dimen/ds_type_sm" />
            </LinearLayout>
        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/ds_space_2"
            android:background="@color/md_border" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_4"
            android:text="ದಿನದ ವಿಶೇಷ"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="@dimen/ds_type_xs" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dateDialogEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_1"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="@dimen/ds_type_md" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/dateDialogSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_1"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="@dimen/ds_type_xs"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
