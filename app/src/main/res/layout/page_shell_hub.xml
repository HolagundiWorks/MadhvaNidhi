<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_background"
    android:padding="@dimen/shell_page_inset">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Carbon.Heading03"
            android:textColor="@color/carbon_text" />

        <TextView
            android:id="@+id/hubSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_02"
            android:textAppearance="@style/TextAppearance.Carbon.Body01"
            android:textColor="@color/carbon_text_secondary" />

        <LinearLayout
            android:id="@+id/hubChildren"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_05"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/hubEmptyStates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_05"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
