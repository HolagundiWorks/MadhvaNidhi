<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/carbon_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:isScrollContainer="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/carbon_spacing_05">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/carbon_layout_size_height_lg"
                android:text="@string/back"
                style="@style/Widget.Carbon.Button.Ghost"
                app:cornerRadius="@dimen/carbon_corner_radius" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_register_title"
                android:textAppearance="@style/TextAppearance.Carbon.Heading03"
                android:layout_marginBottom="@dimen/carbon_spacing_03" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_register_hint"
                android:textAppearance="@style/TextAppearance.Carbon.Label01"
                android:layout_marginBottom="@dimen/carbon_spacing_03"
                android:maxLines="2" />

            <GridLayout
                android:id="@+id/profileFieldsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="1"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:hint="@string/profile_name"
                    style="@style/Widget.Carbon.TextInput.Outlined"
                    app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:hint="@string/profile_veda"
                    style="@style/Widget.Carbon.TextInput.ExposedDropdown"
                    app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/profileVeda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:hint="@string/profile_gotra"
                    style="@style/Widget.Carbon.TextInput.ExposedDropdown"
                    app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/profileGotra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:hint="@string/profile_pravara"
                    style="@style/Widget.Carbon.TextInput.Outlined"
                    app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profilePravara"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:hint="@string/profile_rashi"
                    style="@style/Widget.Carbon.TextInput.ExposedDropdown"
                    app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/profileRashi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:hint="@string/profile_nakshatra"
                    style="@style/Widget.Carbon.TextInput.ExposedDropdown"
                    app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/profileNakshatra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:hint="@string/profile_year_of_birth"
                    style="@style/Widget.Carbon.TextInput.Outlined"
                    app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profileYearOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:maxLength="4"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:hint="@string/profile_place_of_birth"
                    style="@style/Widget.Carbon.TextInput.Outlined"
                    app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profilePlaceOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:imeOptions="actionDone"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/carbon_spacing_05"
        android:paddingEnd="@dimen/carbon_spacing_05"
        android:paddingTop="@dimen/carbon_spacing_03"
        android:paddingBottom="@dimen/carbon_spacing_05"
        android:background="@color/carbon_layer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/carbon_layout_size_height_lg"
            android:text="@string/profile_save"
            app:cornerRadius="@dimen/carbon_corner_radius" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_03"
            android:text="@string/profile_privacy_note"
            android:textAppearance="@style/TextAppearance.Carbon.Label01" />
    </LinearLayout>
</LinearLayout>
