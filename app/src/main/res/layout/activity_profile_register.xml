<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:isScrollContainer="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_4">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/md_button_height"
                android:text="@string/back"
                style="@style/Widget.MadhvaNidhi.Button.Text"
                app:cornerRadius="@dimen/md_corner_radius" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_register_title"
                android:textAppearance="@style/TextAppearance.DS.Headline"
                android:layout_marginBottom="@dimen/ds_space_2" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_register_hint"
                android:textAppearance="@style/TextAppearance.DS.Caption"
                android:layout_marginBottom="@dimen/ds_space_2"
                android:maxLines="2" />

            <GridLayout
                android:id="@+id/profileFieldsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="1"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_2"
                    android:hint="@string/profile_name"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_2"
                    android:hint="@string/profile_veda"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/profileVeda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_2"
                    android:hint="@string/profile_gotra"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/profileGotra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_2"
                    android:hint="@string/profile_pravara"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profilePravara"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:imeOptions="actionNext"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_2"
                    android:hint="@string/profile_rashi"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/profileRashi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_2"
                    android:hint="@string/profile_nakshatra"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/profileNakshatra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_2"
                    android:hint="@string/profile_year_of_birth"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profileYearOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:imeOptions="actionNext"
                        android:maxLength="4"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_space_2"
                    android:hint="@string/profile_place_of_birth"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/md_corner_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/md_corner_radius">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profilePlaceOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:imeOptions="actionDone"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_4"
        android:paddingEnd="@dimen/ds_space_4"
        android:paddingTop="@dimen/ds_space_2"
        android:paddingBottom="@dimen/ds_space_4"
        android:background="@color/md_theme_surfaceContainer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profileSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/md_button_height"
            android:text="@string/profile_save"
            app:cornerRadius="@dimen/md_corner_radius" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:text="@string/profile_privacy_note"
            android:textAppearance="@style/TextAppearance.DS.Caption" />
    </LinearLayout>
</LinearLayout>
