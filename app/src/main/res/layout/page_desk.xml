<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/panchangaScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="4dp">
 <com.google.android.material.textview.MaterialTextView android:id="@+id/panchangaHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body01" android:textColor="@color/carbon_text_secondary" android:layout_marginBottom="8dp" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <com.google.android.material.button.MaterialButton android:id="@+id/chooseDate" style="@style/Widget.Carbon.Button.Ghost" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/carbon_layout_size_height_lg" android:gravity="start|center_vertical" android:textAppearance="@style/TextAppearance.Carbon.Heading02" android:textColor="@color/carbon_text_primary" app:icon="@drawable/ic_calendar" app:iconTint="@color/carbon_icon_primary" />
  <com.google.android.material.button.MaterialButton android:id="@+id/todayDate" style="@style/Widget.Carbon.Button.Icon" android:layout_width="@dimen/carbon_layout_size_height_lg" android:layout_height="@dimen/carbon_layout_size_height_lg" android:contentDescription="ಇಂದಿನ ದಿನಾಂಕ" app:icon="@drawable/ic_today" />
  <com.google.android.material.button.MaterialButton android:id="@+id/clockLockArea" style="@style/Widget.Carbon.Button.Icon" android:layout_width="@dimen/carbon_layout_size_height_lg" android:layout_height="@dimen/carbon_layout_size_height_lg" android:contentDescription="ಪುಟ ಲಾಕ್" app:icon="@drawable/ic_lock" />
  <com.google.android.material.textview.MaterialTextView android:id="@+id/calendarLegend" android:layout_width="72dp" android:layout_height="48dp" android:gravity="center" android:text="ಏಕಾದಶಿ" android:textColor="@color/carbon_orange" android:textAppearance="@style/TextAppearance.Carbon.Label01" />
 </LinearLayout>
 <LinearLayout android:id="@+id/pakshaScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
  <LinearLayout android:id="@+id/shuklaPhaseGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <com.google.android.material.textview.MaterialTextView android:id="@+id/shuklaPhaseTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="ಶುಕ್ಲ ಪಕ್ಷ                                  ● → ◐ → ○" android:textAppearance="@style/TextAppearance.Carbon.Heading01" />
   <GridLayout android:id="@+id/shuklaCalendarRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="15" />
  </LinearLayout>
  <LinearLayout android:id="@+id/krishnaPhaseGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">
   <com.google.android.material.textview.MaterialTextView android:id="@+id/krishnaPhaseTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="ಕೃಷ್ಣ ಪಕ್ಷ                                  ○ → ◑ → ●" android:textAppearance="@style/TextAppearance.Carbon.Heading01" />
   <GridLayout android:id="@+id/krishnaCalendarRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="15" />
  </LinearLayout>
 </LinearLayout>
 <com.google.android.material.card.MaterialCardView android:id="@+id/dayEventsCard" style="@style/Widget.Carbon.Tile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="@dimen/carbon_spacing_02" app:strokeColor="@color/carbon_border" app:strokeWidth="1dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="@dimen/carbon_spacing_04" android:paddingVertical="0dp">
   <com.google.android.material.textview.MaterialTextView android:id="@+id/todayEventsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ದಿನದ ವಿಶೇಷ" android:textAppearance="@style/TextAppearance.Carbon.Label01" android:textColor="@color/carbon_text_secondary" android:layout_marginEnd="@dimen/carbon_spacing_05" />
   <com.google.android.material.textview.MaterialTextView android:id="@+id/dayEvent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" android:textAppearance="@style/TextAppearance.Carbon.Heading01" />
   <com.google.android.material.button.MaterialButton android:id="@+id/eventDetails" style="@style/Widget.Carbon.Button.Icon" android:layout_width="@dimen/carbon_layout_size_height_lg" android:layout_height="@dimen/carbon_layout_size_height_lg" android:contentDescription="ದಿನದ ವಿಶೇಷ ಮತ್ತು ಪಂಚಾಂಗ ವಿವರಗಳು" app:icon="@drawable/ic_nav_next" />
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
 <LinearLayout android:id="@+id/calendarControls" android:layout_width="match_parent" android:layout_height="@dimen/carbon_layout_size_height_lg" android:gravity="center_vertical">
  <com.google.android.material.button.MaterialButton android:id="@+id/calendarPrevious" style="@style/Widget.Carbon.Button.Icon" android:layout_width="@dimen/carbon_layout_size_height_lg" android:layout_height="@dimen/carbon_layout_size_height_lg" android:contentDescription="ಶುಕ್ಲ ಪಕ್ಷ" app:icon="@drawable/ic_nav_prev" />
  <com.google.android.material.textview.MaterialTextView android:id="@+id/calendarRange" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textAppearance="@style/TextAppearance.Carbon.Label01" />
  <com.google.android.material.button.MaterialButton android:id="@+id/calendarNext" style="@style/Widget.Carbon.Button.Icon" android:layout_width="@dimen/carbon_layout_size_height_lg" android:layout_height="@dimen/carbon_layout_size_height_lg" android:contentDescription="ಕೃಷ್ಣ ಪಕ್ಷ" app:icon="@drawable/ic_nav_next" />
 </LinearLayout>
</LinearLayout>
