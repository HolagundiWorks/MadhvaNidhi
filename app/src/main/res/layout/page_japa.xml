<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/md_theme_background">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:background="@color/md_theme_background" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:showDividers="none">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MadhvaNidhi.TextField.Exposed" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ಜಪ ಮಂತ್ರ" app:startIconDrawable="@drawable/ic_japa_eda" app:startIconTint="@color/md_theme_onSurface">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/japaMantra" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:inputType="none" android:textColor="@color/md_theme_onSurface" android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/japaFlowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1 · ಪೂರ್ವಾಂಗ" android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textColor="@color/md_theme_onSurface" android:layout_marginBottom="8dp" android:layout_marginTop="20dp" />
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/japaFlowProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="3" app:indicatorColor="@color/md_theme_primary" />
            <TextView android:id="@+id/japaFlowHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಪೂರ್ವಾಂಗ → ಎಣಿಕೆ → ಉತ್ತರಾಂಗ" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" android:textColor="@color/md_theme_onSurface" android:layout_marginBottom="8dp" android:layout_marginTop="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/japaReadPoorvanga" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="12dp" android:text="ಪೂರ್ವಾಂಗ ಓದಿ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.MadhvaNidhi.SurfaceCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:id="@+id/japaCountTile" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಇಂದಿನ ಜಪ · ದೈನಂದಿನ ಗುರಿ" android:textAppearance="@style/TextAppearance.Material3.LabelLarge" android:textColor="@color/md_theme_onSurface" android:gravity="center" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:gravity="center" android:minHeight="88dp">
                        <TextView android:id="@+id/japaCountDone" android:layout_width="wrap_content" android:layout_margin="6dp" android:layout_height="wrap_content" android:text="64" android:textAppearance="@style/TextAppearance.Material3.DisplayLarge" android:textColor="@color/md_theme_onSurface" android:gravity="end" />
                        <TextView android:id="@+id/japaCountSep" android:layout_width="wrap_content" android:layout_margin="6dp" android:layout_height="wrap_content" android:text="/" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" android:textColor="@color/md_theme_onSurface" android:gravity="center" />
                        <TextView android:id="@+id/japaCountTarget" android:layout_width="wrap_content" android:layout_margin="6dp" android:layout_height="wrap_content" android:text="101" android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" android:textColor="@color/md_theme_onSurface" android:gravity="start" />
                    </LinearLayout>
                    <TextView android:id="@+id/japaStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" android:textColor="@color/md_theme_onSurface" android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/japaTargetNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ಇಂದಿನ ಗುರಿ" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="@color/md_theme_onSurface" android:layout_marginBottom="8dp" />
            <LinearLayout android:id="@+id/japaCountControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/japaTap" style="@style/Widget.MadhvaNidhi.Button.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:text="+  1 ಜಪ" android:textSize="24sp" android:textColor="@color/md_theme_onPrimary" app:cornerRadius="16dp" app:icon="@drawable/ic_japa_eda" app:iconSize="24dp" android:contentDescription="ಒಂದು ಜಪ ಸೇರಿಸಿ · Add one Japa" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                    <com.google.android.material.button.MaterialButton android:id="@+id/japaRecordBatch" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="12dp" android:text="ಮಾಡಿದ ಜಪದ ಸಂಖ್ಯೆ ಸೇರಿಸಿ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" android:layout_weight="1" android:layout_margin="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/japaUndo" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="12dp" android:text="ಹಿಂದಿನ ಎಣಿಕೆ ರದ್ದು" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" android:layout_weight="1" android:layout_margin="4dp" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/japaReadUttaranga" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="12dp" android:text="ಉತ್ತರಾಂಗ ಓದಿ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="12dp" android:background="@color/md_theme_surfaceContainer">
        <com.google.android.material.button.MaterialButton android:id="@+id/japaFlowBack" style="@style/Widget.MadhvaNidhi.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="0dp" android:text="ಹಿಂದಿನ ಹಂತ" android:textSize="16sp" android:textColor="@color/md_theme_onSurface" app:cornerRadius="16dp" android:layout_weight="1" android:layout_marginEnd="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/japaFlowNext" style="@style/Widget.MadhvaNidhi.Button.Filled" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="0dp" android:text="ಎಣಿಕೆ ಪ್ರಾರಂಭಿಸಿ" android:textSize="16sp" android:textColor="@color/md_theme_onPrimary" app:cornerRadius="16dp" android:layout_weight="2" />
    </LinearLayout>
</LinearLayout>