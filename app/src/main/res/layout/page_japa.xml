<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/carbon_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/carbon_spacing_05">

        <!-- Mantra selector + Skip / Complete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/carbon_layout_size_height_lg"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Carbon.TextInput.ExposedDropdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ಜಪ">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/japaMantra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/japaSkip"
                style="@style/Widget.Carbon.Button.Tertiary.Icon"
                android:layout_width="@dimen/carbon_layout_size_height_lg"
                android:layout_height="@dimen/carbon_layout_size_height_lg"
                android:layout_marginStart="@dimen/carbon_spacing_03"
                android:contentDescription="Skip today"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:icon="@drawable/ic_nav_next"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:strokeColor="@color/carbon_border"
                app:strokeWidth="@dimen/carbon_border_width" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/japaComplete"
                style="@style/Widget.Carbon.Button.Tertiary.Icon"
                android:layout_width="@dimen/carbon_layout_size_height_lg"
                android:layout_height="@dimen/carbon_layout_size_height_lg"
                android:layout_marginStart="@dimen/carbon_spacing_02"
                android:contentDescription="Completed for today"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:cornerRadius="@dimen/carbon_corner_radius"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:strokeColor="@color/carbon_border"
                app:strokeWidth="@dimen/carbon_border_width" />
        </LinearLayout>

        <!-- Japa Counter Tile -->
        <LinearLayout
            android:id="@+id/japaCountTile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_04"
            android:background="@color/carbon_layer"
            android:gravity="center"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:padding="@dimen/carbon_spacing_04">

            <TextView
                android:id="@+id/japaCountDone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01"
                android:textAppearance="@style/TextAppearance.Carbon.Heading05"
                android:textColor="@color/carbon_text"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/japaCountSep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/carbon_spacing_02"
                android:text="/"
                android:textAppearance="@style/TextAppearance.Carbon.Heading03"
                android:textColor="@color/carbon_text_secondary" />

            <TextView
                android:id="@+id/japaCountTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="101"
                android:textAppearance="@style/TextAppearance.Carbon.Heading03"
                android:textColor="@color/carbon_text_secondary" />
        </LinearLayout>

        <!-- Goal increments + Tap +1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_04"
            android:gravity="bottom"
            android:orientation="horizontal">

            <GridLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alignmentMode="alignBounds"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/japaGoal11"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/carbon_layout_size_height_lg"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/carbon_spacing_03"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:contentDescription="Add 11 to daily goal"
                    android:text="11"
                    app:cornerRadius="@dimen/carbon_corner_radius"
                    app:strokeColor="@color/carbon_border"
                    app:strokeWidth="@dimen/carbon_border_width" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/japaGoal101"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/carbon_layout_size_height_lg"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="@dimen/carbon_spacing_03"
                    android:contentDescription="Add 101 to daily goal"
                    android:text="101"
                    app:cornerRadius="@dimen/carbon_corner_radius"
                    app:strokeColor="@color/carbon_border"
                    app:strokeWidth="@dimen/carbon_border_width" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/japaGoal1001"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/carbon_layout_size_height_lg"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="@dimen/carbon_spacing_03"
                    android:contentDescription="Add 1,001 to daily goal"
                    android:text="1,001"
                    app:cornerRadius="@dimen/carbon_corner_radius"
                    app:strokeColor="@color/carbon_border"
                    app:strokeWidth="@dimen/carbon_border_width" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/japaReset"
                    style="@style/Widget.Carbon.Button.Tertiary.Icon"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/carbon_layout_size_height_lg"
                    android:layout_columnWeight="1"
                    android:contentDescription="Reset daily goal"
                    app:cornerRadius="@dimen/carbon_corner_radius"
                    app:icon="@drawable/ic_reset"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:strokeColor="@color/carbon_border"
                    app:strokeWidth="@dimen/carbon_border_width" />
            </GridLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/japaTap"
                style="@style/Widget.Carbon.Button.Primary"
                android:layout_width="@dimen/carbon_spacing_10"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/carbon_spacing_04"
                android:contentDescription="Japa +1"
                android:minHeight="@dimen/carbon_spacing_09"
                android:text="+"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/japaStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_03"
            android:minHeight="16dp"
            android:textAppearance="@style/TextAppearance.Carbon.Label01"
            android:textColor="@color/carbon_text_secondary" />

        <!-- Poorvanga / Uttaranga section + Open Content -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/japaAngaTabs"
            style="@style/Widget.Carbon.TabLayout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/carbon_layout_size_height_md"
            android:layout_gravity="start"
            android:layout_marginTop="@dimen/carbon_spacing_05"
            app:tabGravity="start"
            app:tabMode="scrollable" />

        <TextView
            android:id="@+id/japaAngaBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/carbon_layer"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.35"
            android:maxLines="5"
            android:padding="@dimen/carbon_spacing_04"
            android:textAppearance="@style/TextAppearance.Carbon.Body01"
            android:textColor="@color/carbon_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/japaOpenAnga"
            style="@style/Widget.Carbon.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/carbon_spacing_04"
            android:minHeight="@dimen/carbon_layout_size_height_lg"
            android:text="@string/open_anga_reader"
            app:cornerRadius="@dimen/carbon_corner_radius"
            app:icon="@drawable/ic_launch"
            app:iconGravity="textEnd"
            app:iconPadding="@dimen/carbon_spacing_03" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
