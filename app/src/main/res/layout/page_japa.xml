                    <com.google.android.material.textview.MaterialTextView android:id="@+id/japaRitualTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Label01" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_02"  android:textColor="@color/carbon_text_secondary" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/japaRitualStep" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Heading03" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/japaRitualBody" android:lineSpacingMultiplier="1.5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body01" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" />
                    <GridLayout android:id="@+id/japaRitualActionsGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="1">
                        <com.google.android.material.button.MaterialButton android:id="@+id/japaRitualBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="ಹಿಂದಿನ ಕ್ರಮ" style="@style/Widget.Material3.Button.OutlinedButton" app:cornerRadius="@dimen/carbon_corner_radius" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/japaRitualNext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="ಮುಂದಿನ ಕ್ರಮ" app:cornerRadius="@dimen/carbon_corner_radius" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/carbon_spacing_03" app:cardCornerRadius="@dimen/carbon_corner_radius" app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MadhvaNidhi.Four" app:cardBackgroundColor="@color/carbon_layer">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/carbon_spacing_05">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="@dimen/carbon_spacing_03">
<com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginBottom="0dp" android:hint="ಜಪ ಮಂತ್ರ" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" app:boxCornerRadiusTopStart="@dimen/carbon_corner_radius" app:boxCornerRadiusTopEnd="@dimen/carbon_corner_radius" app:boxCornerRadiusBottomStart="@dimen/carbon_corner_radius" app:boxCornerRadiusBottomEnd="@dimen/carbon_corner_radius">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/japaMantra" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/japaComplete" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:visibility="gone" android:layout_marginStart="@dimen/carbon_spacing_03" android:contentDescription="ಅವಧಿ ದಾಖಲಿಸಿ" app:icon="@drawable/ic_confirm" app:iconGravity="textStart" app:iconPadding="0dp" app:cornerRadius="@dimen/carbon_corner_radius" />
<com.google.android.material.button.MaterialButton android:id="@+id/japaReset" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:visibility="gone" android:contentDescription="ಎಣಿಕೆ ಮರುಹೊಂದಿಸಿ" app:icon="@drawable/ic_reset" app:iconGravity="textStart" app:iconPadding="0dp" app:cornerRadius="@dimen/carbon_corner_radius" />
</LinearLayout>
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/japaMantraName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body02" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_02" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/japaMantraNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body01" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03" android:visibility="gone" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/japaWaiting" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Body01" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03"  android:textColor="@color/carbon_text_secondary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/japaCounterPane" android:visibility="gone">
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/japaCurrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Heading05" android:text="0" android:layout_marginBottom="@dimen/carbon_spacing_02" />
                        <GridLayout android:id="@+id/japaActionsGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="1" android:alignmentMode="alignMargins" android:useDefaultMargins="false">
                            <com.google.android.material.button.MaterialButton android:id="@+id/japaTap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="ಜಪ +೧" app:cornerRadius="@dimen/carbon_corner_radius" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/japa108" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="+೧೦೮" style="@style/Widget.Material3.Button.TonalButton" app:cornerRadius="@dimen/carbon_corner_radius" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/japaUndo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="−೧" style="@style/Widget.Material3.Button.OutlinedButton" app:cornerRadius="@dimen/carbon_corner_radius" />
                        </GridLayout>
                        <com.google.android.material.textview.MaterialTextView android:id="@+id/japaSessions" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Carbon.Label01" android:text="" android:layout_marginBottom="@dimen/carbon_spacing_03"  android:textColor="@color/carbon_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>