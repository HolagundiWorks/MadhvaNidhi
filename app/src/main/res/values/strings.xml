    <string name="rangavalli_meaning_title">ರಂಗವಲ್ಲಿ ಅರ್ಥ</string>
    <string name="rangavalli_meaning_body">ರಂಗವಲ್ಲಿ ಮನೆಯ ಹೊಸ್ತಿಲು ಮತ್ತು ಪೂಜಾ ಸ್ಥಳವನ್ನು ಶುದ್ಧಿ–ಸೌಂದರ್ಯದಿಂದ ಅಲಂಕರಿಸುವ ಸಂಪ್ರದಾಯ. ಮಾಧ್ವ ಗೃಹಗಳಲ್ಲಿ ಇದು ಭಕ್ತಿ ಮತ್ತು ಶುಭಸಂಕೇತವಾಗಿ ಉಳಿದಿದೆ. ಚಿತ್ರಗಳು ಸರಳ, ಸಾತ್ತ್ವಿಕ ಮತ್ತು ಕುಟುಂಬಾಚಾರಕ್ಕೆ ಹೊಂದುವಂತಿರಲಿ.</string>
    <string name="rangavalli_occasions_title">ಯಾವಾಗ?</string>
    <string name="rangavalli_occasions_body">ನಿತ್ಯ ಬೆಳಗಿನ ಶುಚಿ, ಹಬ್ಬಗಳು, ಏಕಾದಶಿ, ಸಂಕ್ರಮಣ, ಗೃಹಪ್ರವೇಶ ಮತ್ತು ವಿಶೇಷ ಪೂಜಾ ದಿನಗಳಲ್ಲಿ ರಂಗವಲ್ಲಿ ಹಾಕುವುದು ರೂಢಿ. ಸ್ಥಳೀಯ ಮಠ/ಕುಟುಂಬ ಪದ್ಧತಿಯನ್ನು ಮೊದಲು ಅನುಸರಿಸಿ.</string>
    <string name="rangavalli_practice_title">ಅಭ್ಯಾಸ ಸೂಚನೆ</string>
    <string name="rangavalli_practice_body">ನೆಲವನ್ನು ಸ್ವಚ್ಛಗೊಳಿಸಿ, ಅಕ್ಕಿ ಹಿಟ್ಟು ಅಥವಾ ಸಾತ್ತ್ವಿಕ ಬಣ್ಣ ಬಳಸಿ. ಪದ್ಮ, ತುಳಸಿ, ಶಂಖ, ಚಕ್ರ, ನಾಮ ಮತ್ತು ಸರಳ ಜ್ಯಾಮಿತಿ ಆಕಾರಗಳು ಸಾಮಾನ್ಯ. ಅತಿಯಾದ ಅಲಂಕಾರ ಅಥವಾ ಅಸಾತ್ತ್ವಿಕ ಚಿತ್ರಗಳನ್ನು ಬಿಟ್ಟುಬಿಡಿ.</string>
    <string name="rangavalli_packs_title">ಚಿತ್ರ ಪ್ಯಾಕ್‌ಗಳು</string>
    <string name="rangavalli_packs_body">ವಿನ್ಯಾಸ ಪ್ಯಾಕ್‌ಗಳು (ಛಾಯಾಚಿತ್ರ/ವೆಕ್ಟರ್) ಇನ್ನೂ ಆ್ಯಪ್‌ನಲ್ಲಿ ಸೇರಿಲ್ಲ. ಈ ಪುಟ ಸ್ಥಳೀಯ ಮಾರ್ಗದರ್ಶನ ನೀಡುತ್ತದೆ; ಪ್ಯಾಕ್‌ಗಳು ಬಂದಾಗ ಇದೇ ವಿಭಾಗದಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ.</string>
    <string name="recipes_intro_title">ನೈವೇದ್ಯ / ಪಾಕ ಮಾರ್ಗದರ್ಶನ</string>
    <string name="recipes_intro_body">ಮೊದಲು ಶ್ರೀಹರಿಗೆ, ನಂತರ ಮಹಾಲಕ್ಷ್ಮಿ ಮತ್ತು ಪರಿವಾರ ದೇವತೆಗಳಿಗೆ ನೈವೇದ್ಯ. ಸಾತ್ತ್ವಿಕ ಆಹಾರ, ಕುಟುಂಬಾಚಾರ ಮತ್ತು ಮಠ ನಿರ್ಣಯವನ್ನು ಅನುಸರಿಸಿ. ಕೆಳಗಿನ ಪಟ್ಟಿ ಸ್ಥಳೀಯ ಹಬ್ಬ/ಪೂಜಾ ಪಠ್ಯಗಳಿಂದ.</string>
    <string name="recipes_common_title">ಸಾಮಾನ್ಯ ನೈವೇದ್ಯ ಕ್ರಮ</string>
    <string name="recipes_common_body">ನೈವೇದ್ಯ ಸಿದ್ಧಪಡಿಸಿ, ಪ್ರೋಕ್ಷಣೆ ಮಾಡಿ, ಪ್ರಾಣಾಹುತಿ ಮಂತ್ರಗಳೊಂದಿಗೆ ಅರ್ಪಿಸಿ. ವಿವರವಾದ ಕ್ರಮಕ್ಕೆ ಪೂಜೆ ಕ್ಯಾಟಲಾಗ್‌ನಲ್ಲಿನ ಪಠ್ಯಗಳನ್ನು ನೋಡಿ.</string>
</resources>
