<?xml version="1.0" encoding="utf-8"?>
<!--
  MadhvaNidhi design tokens (Material 3 based).
  Change a value here and it applies to every screen that uses the token.
  Prefix ds_ = design system. Use these tokens in layouts and styles; do not
  add literal dp, sp or colour values to screens.
-->
<resources>

    <!-- Spacing scale (4dp base) -->
    <dimen name="ds_space_1">4dp</dimen>
    <dimen name="ds_space_2">8dp</dimen>
    <dimen name="ds_space_3">12dp</dimen>
    <dimen name="ds_space_4">16dp</dimen>
    <dimen name="ds_space_5">20dp</dimen>
    <dimen name="ds_space_6">24dp</dimen>
    <dimen name="ds_space_8">32dp</dimen>
    <dimen name="ds_space_12">48dp</dimen>

    <!-- Layout roles -->
    <dimen name="ds_page_gutter">16dp</dimen>
    <dimen name="ds_section_gap">24dp</dimen>
    <dimen name="ds_item_gap">12dp</dimen>
    <dimen name="ds_card_padding">20dp</dimen>

    <!-- Corner radius scale -->
    <dimen name="ds_radius_sm">8dp</dimen>
    <dimen name="ds_radius_control">12dp</dimen>
    <dimen name="ds_radius_card">16dp</dimen>
    <dimen name="ds_radius_surface">28dp</dimen>

    <!-- Control sizes -->
    <dimen name="ds_control_height">56dp</dimen>
    <dimen name="ds_control_height_compact">40dp</dimen>
    <dimen name="ds_touch_min">48dp</dimen>
    <dimen name="ds_icon_size">24dp</dimen>
    <dimen name="ds_nav_height">80dp</dimen>

    <!-- Colour roles (aliases of the Material 3 scheme) -->
    <color name="ds_surface">@color/md_theme_surface</color>
    <color name="ds_surface_container">@color/md_theme_surfaceContainer</color>
    <color name="ds_on_surface">@color/md_theme_onSurface</color>
    <color name="ds_on_surface_variant">@color/md_theme_onSurfaceVariant</color>
    <color name="ds_outline">@color/md_theme_outline</color>
    <color name="ds_outline_variant">@color/md_theme_outlineVariant</color>
    <color name="ds_accent">@color/md_theme_primary</color>
    <color name="ds_on_accent">@color/md_theme_onPrimary</color>

    <!-- Text hierarchy: one name per role, each backed by a Material 3 type style -->
    <style name="TextAppearance.DS.Display" parent="TextAppearance.Material3.DisplayLarge" />
    <style name="TextAppearance.DS.Headline" parent="TextAppearance.Material3.HeadlineSmall" />
    <style name="TextAppearance.DS.Title" parent="TextAppearance.Material3.TitleLarge" />
    <style name="TextAppearance.DS.Subtitle" parent="TextAppearance.Material3.TitleMedium" />
    <style name="TextAppearance.DS.Body" parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextAppearance.DS.BodySmall" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.DS.Label" parent="TextAppearance.Material3.LabelLarge" />
    <style name="TextAppearance.DS.Caption" parent="TextAppearance.Material3.LabelMedium" />

    <!-- Card: flat filled surface, 16dp corners -->
    <style name="Widget.DS.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/ds_surface_container</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/ds_radius_card</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/md_theme_hover</item>
    </style>

</resources>
