<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ShapeAppearance.PaperDesk" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.PaperDesk.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.PaperDesk.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.MadhvaNidhi.Four" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Theme.PaperDesk.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="viewInflaterClass">androidx.appcompat.app.AppCompatViewInflater</item>

        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceBright">@color/md_theme_surfaceBright</item>
        <item name="colorSurfaceDim">@color/md_theme_surfaceDim</item>

        <!-- Compat / legacy attrs still read by older layouts -->
        <item name="colorPrimaryVariant">@color/md_theme_primary</item>
        <item name="colorSecondaryVariant">@color/md_theme_secondary</item>
        <item name="colorPrimaryDark">@color/md_theme_surface</item>
        <item name="colorAccent">@color/md_theme_primary</item>
        <item name="android:windowBackground">@color/md_theme_background</item>
        <item name="android:textColorPrimary">@color/md_theme_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_onSurfaceVariant</item>
        <item name="android:textColorHint">@color/md_theme_onSurfaceVariant</item>
        <item name="android:editTextColor">@color/md_theme_onSurface</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorControlNormal">@color/md_theme_onSurfaceVariant</item>
        <item name="colorControlActivated">@color/md_theme_primary</item>
        <item name="colorControlHighlight">@color/md_theme_hover</item>
        <item name="colorButtonNormal">@color/md_theme_surfaceContainerHighest</item>
        <item name="rippleColor">@color/md_theme_hover</item>
        <!-- Flat solid surfaces — no tonal elevation overlays / soft gradients -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.PaperDesk.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PaperDesk</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PaperDesk.Large</item>

        <item name="materialButtonStyle">@style/Widget.MadhvaNidhi.Button.Filled</item>
        <item name="borderlessButtonStyle">@style/Widget.MadhvaNidhi.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.MadhvaNidhi.SurfaceCard</item>
        <item name="checkboxStyle">@style/Widget.Material3.CompoundButton.CheckBox</item>
        <item name="textInputStyle">@style/Widget.MadhvaNidhi.TextField.Outlined</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Primary</item>
        <item name="toolbarStyle">@style/Widget.MadhvaNidhi.Toolbar</item>
        <item name="tabStyle">@style/Widget.MadhvaNidhi.TabLayout</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>

        <item name="android:statusBarColor">@color/md_theme_surface</item>
        <item name="android:navigationBarColor">@color/md_theme_surface</item>
        <item name="android:colorBackgroundCacheHint">@color/md_theme_background</item>
        <item name="android:itemBackground">@color/md_theme_surface</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:colorEdgeEffect">@color/md_theme_primary</item>
        <item name="android:textColorHighlight">@color/md_theme_primaryContainer</item>
        <item name="android:alertDialogTheme">@style/Theme.PaperDesk.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.PaperDesk.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.PaperDesk.Dialog</item>
    </style>

    <style name="Theme.PaperDesk" parent="Theme.PaperDesk.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.PaperDesk.Entry" parent="Theme.PaperDesk">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Theme.PaperDesk.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorSurface">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="android:colorBackground">@color/md_theme_surfaceContainerHigh</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PaperDesk</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <!-- Nitya chrome FAB overlay (was undefined ThemeOverlay.Carbon.NityaFab). -->
    <style name="ThemeOverlay.Carbon.NityaFab" parent="ThemeOverlay.Material3.Button">
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="materialButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>
    </style>

    <!-- Desk.* kept as thin Material3 bridges for residual layouts. -->
    <style name="Desk.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Desk.DialogButton.Positive" parent="Desk.DialogButton">
        <item name="android:textColor">@color/md_theme_primary</item>
    </style>

    <style name="Desk.DialogButton.Negative" parent="Desk.DialogButton">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Desk.MaterialCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/md_theme_surfaceContainer</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/md_theme_outlineVariant</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/md_theme_hover</item>
    </style>

    <style name="Desk.Check" parent="Widget.Material3.CompoundButton.CheckBox" />

    <style name="Desk">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.Seek" parent="Widget.AppCompat.SeekBar">
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:minHeight">@dimen/touch</item>
    </style>

    <style name="Desk.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.Title.Large" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.Clock" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.Body2" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Desk.Meta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Desk.Tag" parent="Desk.Meta">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Desk.Label" parent="Desk.Meta" />

    <style name="Desk.TableHead" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Desk.Table" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.Button" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/btn_h</item>
        <item name="android:textSize">@dimen/type_btn</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Desk.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/btn_h</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Desk.Circle" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">@dimen/touch</item>
        <item name="android:layout_height">@dimen/touch</item>
        <item name="android:minWidth">@dimen/touch</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="iconTint">@color/md_theme_onSurface</item>
        <item name="tint">@color/md_theme_onSurface</item>
    </style>

    <style name="Desk.CircleText" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">@dimen/touch</item>
        <item name="android:layout_height">@dimen/touch</item>
        <item name="android:minWidth">@dimen/touch</item>
        <item name="android:minHeight">@dimen/touch</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="Desk.IconBtn" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/icon_btn</item>
        <item name="android:minHeight">@dimen/icon_btn</item>
        <item name="iconTint">@color/md_theme_primary</item>
    </style>

    <style name="Desk.Link" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch</item>
    </style>

    <style name="Desk.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="android:layout_width">@dimen/fab</item>
        <item name="android:layout_height">@dimen/fab</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_marginRight">@dimen/space_16</item>
        <item name="android:layout_marginBottom">@dimen/space_24</item>
    </style>

    <style name="Desk.Field" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:minHeight">@dimen/field_h</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="android:textColorHint">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Desk.Key" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">@dimen/type_key</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_margin">@dimen/key_gap</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Desk.Key.Op" parent="Desk.Key">
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Desk.Key.Accent" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/type_key</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_margin">@dimen/key_gap</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Desk.Page">
        <item name="android:background">@color/md_theme_background</item>
        <item name="android:paddingLeft">@dimen/page_pad_h</item>
        <item name="android:paddingRight">@dimen/page_pad_h</item>
        <item name="android:paddingTop">@dimen/page_pad_top</item>
        <item name="android:paddingBottom">@dimen/page_pad_bottom</item>
    </style>
</resources>
