        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Carbon.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Carbon.Square</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
        <item name="materialButtonStyle">@style/Widget.Carbon.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Carbon.Button.Tertiary</item>
        <item name="borderlessButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
        <item name="materialCardViewStyle">@style/Widget.Carbon.Tile</item>
        <item name="textInputStyle">@style/Widget.Carbon.TextInput</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="Theme.PaperDesk.Entry" parent="Theme.PaperDesk" />
    <style name="Theme.PaperDesk.Dialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/carbon_interactive</item>
        <item name="colorOnPrimary">@color/carbon_text_on_color</item>
        <item name="colorPrimaryContainer">@color/carbon_layer_selected</item>
        <item name="colorOnPrimaryContainer">@color/carbon_text_primary</item>
        <item name="colorSecondary">@color/carbon_interactive</item>
        <item name="colorOnSecondary">@color/carbon_text_on_color</item>
        <item name="colorSecondaryContainer">@color/carbon_layer_high</item>
        <item name="colorOnSecondaryContainer">@color/carbon_interactive</item>
        <item name="colorTertiary">@color/carbon_interactive</item>
        <item name="colorOnTertiary">@color/carbon_text_on_color</item>
        <item name="colorSurface">@color/carbon_background</item>
        <item name="colorOnSurface">@color/carbon_text</item>
        <item name="colorSurfaceVariant">@color/carbon_layer</item>
        <item name="colorOnSurfaceVariant">@color/carbon_text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/carbon_background</item>
        <item name="colorSurfaceContainerLow">@color/carbon_layer</item>
        <item name="colorSurfaceContainer">@color/carbon_layer</item>
        <item name="colorSurfaceContainerHigh">@color/carbon_layer_high</item>
        <item name="colorSurfaceContainerHighest">@color/carbon_layer_high</item>
        <item name="colorOutline">@color/carbon_outline</item>
        <item name="colorOutlineVariant">@color/carbon_border</item>
        <item name="colorError">@color/carbon_error</item>
        <item name="colorOnError">@color/carbon_text_on_color</item>
        <item name="colorErrorContainer">@color/carbon_error_container</item>
        <item name="colorOnErrorContainer">@color/carbon_text</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Carbon.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Carbon.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Carbon.Square</item>
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Carbon.Square</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Carbon.Square</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Carbon.Square</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Carbon.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Carbon.Square</item>
    </style>

    <!-- Carbon productive surfaces: 0 corner (cds border-radius) -->
    <style name="ShapeAppearance.Carbon.Square" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/carbon_corner_radius</item>
    </style>
    <style name="ShapeAppearanceOverlay.Carbon.Square" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/carbon_corner_radius</item>
    </style>

    <!-- Legacy name aliases → Carbon square (keep refs compiling) -->
    <style name="ShapeAppearance.MadhvaNidhi.Four" parent="ShapeAppearance.Carbon.Square" />
    <style name="ShapeAppearanceOverlay.MadhvaNidhi.Four" parent="ShapeAppearanceOverlay.Carbon.Square" />

    <style name="ThemeOverlay.Carbon.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Carbon.Square</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Carbon.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
    </style>
    <style name="ThemeOverlay.MadhvaNidhi.CarbonDialog" parent="ThemeOverlay.Carbon.Dialog" />

    <!-- Content switcher choice (Panchanga paksha) — Carbon pattern on Material button -->
    <style name="Widget.Carbon.ContentSwitcher.Item" parent="Widget.Carbon.Button.Ghost">
        <item name="android:minHeight">@dimen/carbon_layout_size_height_lg</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/carbon_spacing_05</item>
        <item name="android:paddingEnd">@dimen/carbon_spacing_05</item>
        <item name="android:textAppearance">@style/TextAppearance.Carbon.Label01</item>
        <item name="android:textColor">@color/carbon_text</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_paksha_choice</item>
        <item name="iconPadding">@dimen/carbon_spacing_03</item>
        <item name="iconTint">@color/carbon_icon_primary</item>
        <item name="rippleColor">@color/carbon_layer_high</item>
    </style>
    <style name="Widget.MadhvaNidhi.PakshaChoice" parent="Widget.Carbon.ContentSwitcher.Item" />

    <style name="ThemeOverlay.Carbon.Calendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Carbon.Square</item>
        <item name="materialCalendarHeaderConfirmButton">@style/Widget.Carbon.Button.Ghost</item>
        <item name="materialCalendarHeaderCancelButton">@style/Widget.Carbon.Calendar.Cancel</item>
        <item name="materialCalendarMonthNavigationButton">@style/Widget.Carbon.Calendar.MonthNav</item>
        <item name="materialCalendarYearNavigationButton">@style/Widget.Carbon.Calendar.YearNav</item>
        <item name="materialCalendarStyle">@style/Widget.Carbon.Calendar</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Carbon.Button.Ghost</item>
    </style>
    <style name="ThemeOverlay.MadhvaNidhi.Calendar" parent="ThemeOverlay.Carbon.Calendar" />
    <style name="ThemeOverlay.MadhvaNidhi.AccessibleDatePicker" parent="ThemeOverlay.Carbon.Calendar">
        <item name="materialCalendarHeaderSelection">@style/Widget.Carbon.Calendar.HeaderSelection</item>
    </style>

    <style name="Widget.Carbon.Calendar.HeaderSelection" parent="Widget.Material3.MaterialCalendar.HeaderSelection">
        <item name="android:textAppearance">@style/TextAppearance.Carbon.HeadingCompact01</item>
    </style>
