    </style>
    <style name="Widget.Carbon.Calendar.YearSelected" parent="Widget.Material3.MaterialCalendar.Year.Selected">
        <item name="itemShapeAppearance">@style/ShapeAppearance.Carbon.Square</item>
    </style>
    <style name="Widget.Carbon.Calendar.YearToday" parent="Widget.Material3.MaterialCalendar.Year.Today">
        <item name="itemShapeAppearance">@style/ShapeAppearance.Carbon.Square</item>
    </style>
