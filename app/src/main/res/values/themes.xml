        <item name="dayTodayStyle">@style/Widget.Carbon.Calendar.DayToday</item>
        <item name="dayInvalidStyle">@style/Widget.Carbon.Calendar.DayInvalid</item>
        <item name="yearStyle">@style/Widget.Carbon.Calendar.Year</item>
        <item name="yearSelectedStyle">@style/Widget.Carbon.Calendar.YearSelected</item>
        <item name="yearTodayStyle">@style/Widget.Carbon.Calendar.YearToday</item>
    </style>
    <style name="Widget.MadhvaNidhi.Calendar" parent="Widget.Carbon.Calendar" />

