    </style>
    <style name="Widget.Carbon.Calendar.DaySelected" parent="Widget.Material3.MaterialCalendar.Day.Selected">
        <item name="itemShapeAppearance">@style/ShapeAppearance.Carbon.Square</item>
    </style>
    <style name="Widget.Carbon.Calendar.DayToday" parent="Widget.Material3.MaterialCalendar.Day.Today">
        <item name="itemShapeAppearance">@style/ShapeAppearance.Carbon.Square</item>
