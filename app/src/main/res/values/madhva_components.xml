<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy Widget.MadhvaNidhi.* names retained for layouts; visuals are Material 3. -->
<resources>
    <style name="Widget.MadhvaNidhi" parent="" />
    <style name="Widget.MadhvaNidhi.Button" parent="Widget.MadhvaNidhi.Button.Filled" />

    <style name="Widget.MadhvaNidhi.Button.Primary" parent="Widget.MadhvaNidhi.Button.Filled" />

    <style name="Widget.MadhvaNidhi.Button.Ghost" parent="Widget.MadhvaNidhi.Button.Text">
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="iconTint">@color/md_theme_onSurface</item>
    </style>

    <style name="Widget.MadhvaNidhi.Button.Tertiary" parent="Widget.MadhvaNidhi.Button.Outlined">
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="iconTint">@color/md_theme_primary</item>
    </style>

    <style name="Widget.MadhvaNidhi.Button.Icon" parent="Widget.MadhvaNidhi.IconButton.Standard">
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.MadhvaNidhi.Button.Tertiary.Icon" parent="Widget.MadhvaNidhi.Button.Tertiary">
        <item name="strokeColor">@color/md_theme_outline</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
        <item name="iconTint">@color/md_theme_onSurfaceVariant</item>
        <item name="iconSize">16dp</item>
        <item name="android:minWidth">@dimen/md_layout_size_height_md</item>
        <item name="android:minHeight">@dimen/md_layout_size_height_md</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="cornerRadius">@dimen/md_corner_radius</item>
    </style>


    <style name="Widget.MadhvaNidhi.TextInput.ExposedDropdown" parent="Widget.MadhvaNidhi.TextField.Exposed" />

    <style name="Widget.MadhvaNidhi.RailButton" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/md_corner_radius</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/md_layout_size_height_lg</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/md_spacing_05</item>
        <item name="android:paddingEnd">@dimen/md_spacing_05</item>
        <item name="iconTint">@color/md_theme_onSurfaceVariant</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="rippleColor">@color/md_theme_hover</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_rail_item</item>
    </style>

    <style name="Widget.MadhvaNidhi.Tile" parent="Widget.MadhvaNidhi.SurfaceCard" />

    <style name="Widget.MadhvaNidhi.Tile.Clickable" parent="Widget.MadhvaNidhi.Button.Tonal">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:paddingStart">@dimen/md_spacing_05</item>
        <item name="android:paddingEnd">@dimen/md_spacing_05</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
    </style>

    <style name="Widget.MadhvaNidhi.Tag" parent="Widget.MadhvaNidhi.Button.Tonal">
        <item name="backgroundTint">@color/md_theme_secondaryContainer</item>
        <item name="android:textColor">@color/md_theme_onSecondaryContainer</item>
        <item name="android:minHeight">@dimen/md_layout_size_height_sm</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/md_spacing_03</item>
        <item name="android:paddingEnd">@dimen/md_spacing_03</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelMedium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MadhvaNidhi.Tag.Warning" parent="Widget.MadhvaNidhi.Tag">
        <item name="backgroundTint">@color/md_theme_tertiaryContainer</item>
        <item name="android:textColor">@color/md_theme_onTertiaryContainer</item>
        <item name="iconTint">@color/md_theme_onTertiaryContainer</item>
    </style>

    <style name="Widget.MadhvaNidhi.EmptyState">
        <item name="android:background">@color/md_theme_surfaceContainer</item>
        <item name="android:padding">@dimen/md_spacing_05</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Widget.MadhvaNidhi.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/md_theme_surfaceContainerHighest</item>
        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>
        <item name="boxStrokeColor">@color/md_theme_outline</item>
        <item name="hintTextColor">@color/md_theme_primary</item>
        <item name="android:textColorHint">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="Widget.MadhvaNidhi.ContentSwitcher.Item" parent="Widget.MadhvaNidhi.Segmented.Item">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.MadhvaNidhi.TextInput.Outlined" parent="Widget.MadhvaNidhi.TextField.Outlined" />
</resources>
